---
import { DEFAULT_TASKS } from '../lib/journal';
---

<div id="dailyBoard" class="daily-board">
  <section class="page-heading journal-heading">
    <div><h1>Daily Journal</h1><p class="selected-date"><span id="selectedDayText">Today</span><span id="dayLabel" class="date-badge">Today</span></p></div>
    <div class="page-actions"><button id="returnToday" type="button" class="subtle-btn" hidden>Today</button><a class="subtle-btn calendar-link" href="#yearCalendar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 11h18"/></svg>Calendar</a></div>
  </section>
  <div class="journal-status" id="journalStatus" aria-live="polite" hidden><p id="accessHint"></p><button id="retryLoad" type="button" class="subtle-btn" hidden>Retry</button></div>
  <div class="daily-layout">
    <div class="daily-main">
    <section class="task-card" aria-labelledby="boardTitle">
      <div class="section-top"><h2 id="boardTitle">Checklist</h2><button id="editTasks" type="button" class="subtle-btn" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m16 3 5 5-12 12-6 1 1-6L16 3Zm-3 3 5 5"/></svg>Edit tasks</button></div>
      <div id="taskList" class="list" aria-busy="true">{DEFAULT_TASKS.map((task) => (<button type="button" class="task" disabled><span class="checkbox" aria-hidden="true"></span><span class="task-words"><span class="task-title">{task.title}</span><span class="task-detail">{task.detail}</span></span></button>))}</div>
      <div class="board-bottom"><p id="footerStatus" role="status">Loading…</p><button class="text-btn" id="retryChecks" type="button" hidden>Retry saving</button><button type="button" id="resetDay" class="text-btn" disabled>Reset checkmarks</button></div>
    </section>
    <section class="notes"><div class="notes-heading"><label for="dayNote">Daily notes</label></div><textarea id="dayNote" maxlength="10000" rows="5" placeholder="Write a note…" disabled></textarea><div class="note-foot"><p id="saveHint" class="save-hint" role="status"></p><button id="retryNote" class="text-btn" type="button" hidden>Retry saving</button></div></section>
    </div>
    <aside class="daily-side" aria-label="Progress overview">
      <section class="progress-card" aria-labelledby="progressLabel"><h2 class="card-label" id="progressLabel">Progress</h2><div class="progress-wrap"><div class="ring" id="progressRing" role="img" aria-label="0 percent completed"><div class="ring-inner"><div class="percent" id="percent">0%</div></div></div><div class="progress-side"><strong id="doneCount">0 / {DEFAULT_TASKS.length}</strong><p>Tasks completed</p></div></div></section>
      <section class="weekly" aria-labelledby="weeklyTitle"><div class="weekly-head"><h2 id="weeklyTitle">Last 7 days</h2><span>Completion</span></div><div class="week-bars" id="weekBars"></div></section>
    </aside>
  </div>
  <section class="year-calendar" id="yearCalendar" aria-labelledby="calendarTitle">
    <div class="calendar-top"><h2 id="calendarTitle">Calendar</h2><div class="year-switcher" aria-label="Choose calendar year"><button id="previousYear" class="icon-btn" type="button" aria-label="Previous year">←</button><strong id="calendarYear">—</strong><button id="nextYear" class="icon-btn" type="button" aria-label="Next year">→</button></div></div>
    <div class="year-summary" id="yearSummary" aria-live="polite"><span>No recorded days yet.</span></div>
    <div class="calendar-legend" aria-label="Calendar color legend"><span><i class="legend-color no-record"></i>No record</span><span><i class="legend-color progress-zero"></i>Recorded</span><span><i class="legend-color progress-partial"></i>In progress</span><span><i class="legend-color progress-full"></i>Complete</span><span><i class="legend-color today-mark"></i>Today</span></div>
    <div class="month-grid" id="yearMonths" aria-busy="true"></div>
  </section>
  <noscript><p class="no-script">Enable JavaScript to load the cloud journal and choose calendar dates.</p></noscript>
  <dialog id="taskEditor" aria-labelledby="editTitle"><form id="taskEditorForm"><div class="dialog-head"><div><h2 id="editTitle">Edit checklist</h2><p id="editorDate">Changes preserve every other day's saved tasks.</p></div><button type="button" class="icon-btn" id="closeTaskEditor" aria-label="Close task editor">×</button></div><div class="dialog-body"><div id="editRows"></div><label class="future-template"><input type="checkbox" id="applyToFuture" /><span>Also use these tasks for days with no saved record.<small id="templateHint">Existing daily records keep their own task lists.</small></span></label><p id="editorError" role="alert" hidden></p></div><div class="dialog-foot"><button type="button" class="subtle-btn" id="addTask">+ Add task</button><div class="dialog-actions"><button type="button" class="subtle-btn" id="cancelTaskEditor">Cancel</button><button type="submit" class="filled-btn" id="saveTasks">Save changes</button></div></div></form></dialog>
  <dialog id="resetDialog" aria-labelledby="resetTitle"><form id="resetForm"><div class="dialog-head"><div><h2 id="resetTitle">Reset this day's checkmarks?</h2><p id="resetDescription">The tasks and note will be kept.</p></div></div><div class="dialog-foot"><button type="button" class="subtle-btn" id="cancelReset">Cancel</button><button type="submit" class="filled-btn" id="confirmReset">Reset checkmarks</button></div></form></dialog>
  <dialog id="noteConflict" aria-labelledby="conflictTitle"><div class="dialog-head"><div><h2 id="conflictTitle">Review a note conflict</h2><p>Another device saved this day while you were writing. Compare both versions before choosing what to keep.</p></div></div><div class="dialog-body"><label class="conflict-label" for="cloudNote">Latest note in the cloud</label><textarea id="cloudNote" class="conflict-note" rows="5" readonly></textarea><label class="conflict-label" for="localNote">Your unsaved draft</label><textarea id="localNote" class="conflict-note" rows="5" readonly></textarea><p id="conflictError" role="alert" hidden></p></div><div class="dialog-foot"><button type="button" id="cancelConflict" class="subtle-btn">Keep reviewing</button><div class="dialog-actions"><button type="button" id="useCloudNote" class="subtle-btn">Use cloud note</button><button type="button" id="keepDraftNote" class="filled-btn">Save my draft</button></div></div></dialog>
  <div id="journalToast" class="journal-toast" role="status" aria-live="polite"></div>
</div>
<script>import '../scripts/checklist';</script>
<style>
  .journal-heading { align-items:center; }
  .selected-date { margin:9px 0 0; display:flex; gap:10px; align-items:center; flex-wrap:wrap; color:var(--muted); font-size:15px; line-height:1.5; }
  .date-badge { padding:2px 7px; background:var(--primary-soft); color:var(--primary); font-size:11px; font-weight:550; border-radius:5px; }
  .page-actions { display:flex; align-items:center; gap:8px; }
  .journal-status { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px; padding:10px 14px; margin-bottom:18px; border:1px solid var(--line); border-radius:8px; background:var(--surface-2); }
  .journal-status p { margin:0; color:var(--muted); font-size:14px; }
  .journal-status[data-error="true"] p { color:var(--orange); }
  .daily-layout { display:grid; grid-template-columns:minmax(0,1fr) 292px; gap:24px; align-items:start; }
  .daily-main { min-width:0; }
  .task-card { padding:22px 26px 14px; background:var(--surface); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow); }
  .section-top { display:flex; align-items:center; justify-content:space-between; gap:16px; }
  .section-top h2 { margin:0; font-size:20px; font-weight:600; letter-spacing:-.03em; }
  .section-top .subtle-btn { min-height:36px; font-size:13px; padding:7px 10px; }
  .list { margin-top:22px; }
  .daily-board :global(.group) { margin-top:20px; }
  .daily-board :global(.group:first-child) { margin-top:0; }
  .daily-board :global(.group-head) { display:flex; justify-content:space-between; align-items:center; gap:12px; margin:0 -10px 2px; padding:7px 10px; border-radius:5px; background:var(--surface-2); color:var(--muted); font-size:13px; font-weight:550; }
  .daily-board :global(.group-name) { display:flex; align-items:center; gap:8px; min-width:0; }
  .daily-board :global(.group-dot) { width:5px; height:5px; flex-shrink:0; border-radius:50%; background:var(--dim); }
  .daily-board :global(.group-count) { font-size:13px; font-weight:450; font-variant-numeric:tabular-nums; }
  .daily-board :global(.task) { display:flex; align-items:center; gap:13px; width:100%; min-height:60px; padding:12px 0; margin:0; text-align:left; color:var(--text); border:0; border-bottom:1px solid var(--line); border-radius:0; background:transparent; transition:background .15s; }
  .daily-board :global(.task:last-child) { border-bottom:0; }
  .daily-board :global(.task:hover:not(:disabled)) { background:var(--surface-2); }
  .daily-board :global(.task:disabled) { cursor:default; opacity:1; }
  .daily-board :global(.task:focus-visible) { outline-offset:3px; }
  .daily-board :global(.checkbox) { display:grid; place-items:center; flex:0 0 21px; width:21px; height:21px; border:1.5px solid #8a93a3; border-radius:5px; color:var(--surface); font-size:15px; line-height:1; }
  .daily-board :global(.task.checked .checkbox) { background:var(--primary); border-color:var(--primary); }
  .daily-board :global(.task-words) { flex:1; min-width:0; }
  .daily-board :global(.task-title) { display:block; font-size:17px; font-weight:500; line-height:1.5; overflow-wrap:anywhere; letter-spacing:-.02em; }
  .daily-board :global(.task-detail) { display:block; margin-top:2px; color:var(--muted); font-size:16px; line-height:1.6; overflow-wrap:anywhere; }
  .daily-board :global(.task-detail:empty) { display:none; }
  .daily-board :global(.task.checked .task-title) { color:var(--dim); text-decoration:line-through; text-decoration-thickness:1px; }
  .daily-board :global(.task-index) { color:var(--dim); font-size:11px; font-variant-numeric:tabular-nums; opacity:.75; }
  .board-bottom { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:8px 12px; margin-top:14px; padding-top:12px; border-top:1px solid var(--line); }
  .board-bottom p { flex:1; margin:0; color:var(--dim); font-size:13px; line-height:1.6; }
  .board-bottom p[data-error="true"] { color:var(--orange); }
  .text-btn { background:none; border:0; padding:7px 0; min-height:34px; color:var(--muted); font-size:13px; text-decoration:underline; text-underline-offset:3px; }
  .text-btn:hover:not(:disabled) { color:var(--primary); }
  .daily-side { display:grid; gap:18px; position:sticky; top:24px; min-width:0; }
  .progress-card,.weekly { padding:22px; background:var(--surface); border:1px solid var(--line); border-radius:14px; box-shadow:var(--shadow); }
  .card-label,.weekly-head h2 { margin:0; font-size:15px; line-height:1.5; font-weight:600; letter-spacing:-.02em; }
  .progress-wrap { display:flex; align-items:center; gap:20px; margin-top:22px; }
  .ring { display:grid; place-items:center; flex:0 0 94px; width:94px; height:94px; border-radius:50%; background:conic-gradient(var(--primary) var(--p,0%),var(--surface-3) 0%); }
  .ring-inner { display:grid; place-items:center; width:80px; height:80px; border-radius:50%; background:var(--surface); }
  .percent { font-size:25px; font-weight:600; letter-spacing:-.045em; font-variant-numeric:tabular-nums; line-height:1.2; }
  .progress-side { min-width:0; }
  .progress-side strong { font-size:23px; font-weight:550; letter-spacing:-.04em; font-variant-numeric:tabular-nums; }
  .progress-side p { margin:4px 0 0; color:var(--dim); font-size:13px; line-height:1.6; }
  .weekly-head { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .weekly-head span { color:var(--dim); font-size:11px; }
  .week-bars { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:6px; margin-top:22px; }
  .daily-board :global(.week-item) { display:flex; flex-direction:column; align-items:center; gap:8px; min-width:0; padding:3px 0; border:0; border-radius:5px; background:none; color:var(--dim); font-size:11px; }
  .daily-board :global(.week-item:hover) { background:var(--surface-2); }
  .daily-board :global(.week-item[aria-current="date"]) { color:var(--primary); font-weight:600; }
  .daily-board :global(.bar-value) { font-size:11px; font-variant-numeric:tabular-nums; }
  .daily-board :global(.bar-track) { display:flex; align-items:flex-end; overflow:hidden; height:76px; width:18px; max-width:100%; border-radius:4px; background:var(--surface-3); }
  .daily-board :global(.bar-fill) { width:100%; border-radius:3px; background:var(--primary); }
  .notes { margin-top:22px; }
  .notes-heading { margin-bottom:10px; }
  .notes label { font-size:17px; font-weight:600; letter-spacing:-.02em; }
  .notes textarea { display:block; width:100%; min-height:160px; resize:vertical; padding:16px 18px; border:1px solid var(--line); border-radius:12px; background:var(--surface-2); color:var(--text); font-size:17px; line-height:1.7; }
  .notes textarea::placeholder { color:var(--dim); }
  .notes textarea:focus { outline:2px solid var(--primary-soft); border-color:var(--primary); background:var(--surface); }
  .notes textarea:disabled { opacity:1; }
  .note-foot { display:flex; justify-content:space-between; gap:12px; margin-top:8px; }
  .note-foot p { margin:0; font-size:13px; }
  .year-calendar { margin-top:38px; padding-top:30px; border-top:1px solid var(--line); }
  .calendar-top { display:flex; justify-content:space-between; align-items:center; gap:18px; }
  .calendar-top h2 { margin:0; font-size:25px; font-weight:600; letter-spacing:-.04em; }
  .year-switcher { display:flex; align-items:center; gap:12px; }
  .year-switcher strong { min-width:48px; text-align:center; font-size:18px; font-weight:550; font-variant-numeric:tabular-nums; }
  .year-switcher .icon-btn { min-height:34px; width:34px; border-color:transparent; font-size:17px; }
  .year-summary { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; padding:20px 0; margin-top:8px; color:var(--dim); font-size:13px; }
  .daily-board :global(.year-summary>span) { display:flex; flex-direction:column; gap:2px; }
  .daily-board :global(.year-summary strong) { color:var(--text); font-size:26px; font-weight:550; letter-spacing:-.045em; font-variant-numeric:tabular-nums; }
  .calendar-legend { display:flex; flex-wrap:wrap; gap:10px 18px; padding:0 0 20px; color:var(--dim); font-size:13px; }
  .calendar-legend>span { display:flex; align-items:center; gap:7px; }
  .legend-color { display:inline-block; flex-shrink:0; width:10px; height:10px; border:1px solid var(--line); border-radius:3px; background:var(--surface); }
  .legend-color.progress-zero { background:var(--surface-3); }
  .legend-color.progress-partial { background:var(--primary-soft); border-color:var(--primary); }
  .legend-color.progress-full { background:var(--primary); border-color:var(--primary); }
  .legend-color.today-mark { border:2px solid var(--primary); }
  .month-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
  .daily-board :global(.calendar-month) { min-width:0; padding:17px 14px; border:1px solid var(--line); border-radius:12px; background:var(--surface); }
  .daily-board :global(.calendar-month h3) { margin:0 0 14px; font-size:15px; font-weight:600; letter-spacing:-.02em; }
  .daily-board :global(.month-weekdays),.daily-board :global(.month-days) { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:4px; }
  .daily-board :global(.month-weekdays) { margin-bottom:8px; }
  .daily-board :global(.month-weekdays span) { color:var(--dim); text-align:center; font-size:12px; }
  .daily-board :global(.calendar-day) { position:relative; width:100%; min-width:0; min-height:27px; aspect-ratio:1; padding:0; border:1px solid transparent; border-radius:5px; background:var(--surface-2); color:var(--muted); font-size:14px; font-variant-numeric:tabular-nums; }
  .daily-board :global(.calendar-day.recorded) { background:var(--surface-3); color:var(--text); }
  .daily-board :global(.calendar-day.partial) { background:var(--primary-soft); color:var(--primary); border-color:var(--primary-soft); }
  .daily-board :global(.calendar-day.complete) { background:var(--primary); color:var(--bg); }
  .daily-board :global(.calendar-day.today) { border:1.5px solid var(--primary); }
  .daily-board :global(.calendar-day[aria-pressed="true"]) { outline:2px solid var(--text); outline-offset:2px; z-index:1; }
  .daily-board :global(.calendar-day.future) { opacity:.55; }
  .daily-board :global(.calendar-day:hover) { border-color:var(--primary); opacity:1; }
  .daily-board :global(.calendar-day.has-note::after) { content:''; position:absolute; width:3px; height:3px; right:3px; bottom:3px; border-radius:50%; background:currentColor; }
  .daily-board :global(.edit-entry) { display:grid; grid-template-columns:minmax(0,1fr) 124px 36px; gap:8px; margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--line); }
  .daily-board :global(.edit-fields) { display:flex; flex-direction:column; gap:8px; }
  .daily-board :global(.editor-input) { min-width:0; width:100%; padding:10px 12px; border:1px solid var(--line); border-radius:7px; background:var(--surface); color:var(--text); font-size:16px; }
  .daily-board :global(.editor-select) { height:44px; }
  .daily-board :global(.delete-task) { height:44px; border:1px solid var(--line); border-radius:7px; background:var(--surface); color:var(--orange); font-size:22px; }
  .future-template { display:flex; align-items:flex-start; gap:11px; color:var(--text); font-size:15px; line-height:1.65; }
  .future-template input { width:18px; height:18px; flex-shrink:0; margin-top:4px; accent-color:var(--primary); }
  .future-template small { display:block; margin-top:5px; color:var(--muted); font-size:13px; }
  #editorError,#conflictError { color:var(--orange); font-size:15px; line-height:1.6; }
  .dialog-actions { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:8px; }
  .journal-toast { position:fixed; bottom:24px; right:24px; z-index:80; max-width:min(400px,calc(100vw - 32px)); padding:12px 16px; border-radius:10px; background:var(--button-bg); color:var(--button-text); box-shadow:var(--shadow); font-size:14px; line-height:1.6; opacity:0; transform:translateY(10px); transition:opacity .2s,transform .2s; pointer-events:none; }
  .journal-toast.show { opacity:1; transform:translateY(0); }
  .daily-board :global(.empty-tasks),.no-script { color:var(--muted); font-size:16px; line-height:1.75; }
  .conflict-label { display:block; margin:0 0 9px; font-size:15px; font-weight:550; }
  .conflict-note { display:block; width:100%; padding:14px; margin-bottom:18px; resize:vertical; color:var(--text); background:var(--surface-2); border:1px solid var(--line); border-radius:8px; font-size:17px; line-height:1.7; }
  @media(max-width:1100px) { .month-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } .daily-layout { grid-template-columns:minmax(0,1fr) 266px; gap:20px; } .progress-card,.weekly { padding:20px; } .progress-wrap { gap:15px; } .ring { width:84px; height:84px; flex-basis:84px; } .ring-inner { width:72px; height:72px; } }
  @media(max-width:850px) { .daily-layout { grid-template-columns:minmax(0,1fr); } .daily-side { position:static; grid-template-columns:repeat(2,minmax(0,1fr)); } .weekly-head span { display:none; } .month-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:600px) {
    .journal-heading { align-items:flex-start; gap:12px; }
    .selected-date { font-size:14px; gap:6px; }
    .page-actions { flex-direction:column-reverse; align-items:flex-end; gap:6px; padding-top:1px; }
    .calendar-link { padding:7px 9px; font-size:13px; min-height:36px; }
    .calendar-link svg { display:none; }
    .task-card { padding:18px 20px 12px; border-radius:12px; }
    .list { margin-top:20px; }
    .section-top h2 { font-size:19px; }
    .daily-board :global(.task) { padding-block:11px; min-height:57px; gap:11px; }
    .daily-board :global(.task-title) { font-size:17px; }
    .daily-board :global(.task-detail) { font-size:16px; }
    .daily-board :global(.task-index) { display:none; }
    .daily-side { grid-template-columns:1fr; gap:14px; }
    .progress-wrap { margin-top:14px; gap:22px; }
    .progress-card,.weekly { padding:20px; border-radius:12px; }
    .weekly-head span { display:block; }
    .week-bars { margin-top:15px; gap:10px; }
    .daily-board :global(.bar-track) { width:24px; height:58px; }
    .notes { margin-top:20px; }
    .notes textarea { min-height:150px; padding:14px; }
    .year-calendar { margin-top:30px; padding-top:24px; }
    .calendar-top h2 { font-size:23px; }
    .year-summary { gap:12px; grid-template-columns:repeat(2,minmax(0,1fr)); }
    .daily-board :global(.year-summary strong) { font-size:24px; }
    .month-grid { grid-template-columns:1fr; gap:14px; }
    .daily-board :global(.calendar-month) { padding:18px; }
    .daily-board :global(.calendar-day) { min-height:36px; font-size:14px; }
    .daily-board :global(.month-weekdays span) { font-size:12px; }
    .daily-board :global(.calendar-month h3) { font-size:17px; }
    .daily-board :global(.edit-entry) { grid-template-columns:minmax(0,1fr) 36px; }
    .daily-board :global(.edit-entry select) { grid-column:1; grid-row:2; }
    .daily-board :global(.edit-entry .delete-task) { grid-column:2; grid-row:1; }
  }
  @media(max-width:360px) { .task-card { padding-inline:16px; } .selected-date { font-size:13px; } .date-badge { display:none; } .daily-board :global(.checkbox) { flex-basis:20px; width:20px; height:20px; } }
</style>

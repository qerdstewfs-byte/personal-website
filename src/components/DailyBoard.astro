---
import { DEFAULT_TASKS } from '../lib/journal';
---

<div id="dailyBoard" class="daily-board">
  <section class="welcome">
    <div class="welcome-copy"><div class="eyebrow" id="dayLabel">DAILY JOURNAL · BEIJING TIME</div><h1><span id="greeting" class="greeting">Make today count</span><span>.</span></h1><p class="intro">A space for research, learning, and daily progress.</p></div>
    <div class="welcome-actions"><div class="day-pill"><strong id="selectedDayText">Today</strong><small id="selectedDaySub">Dates follow Asia/Shanghai · UTC+8</small></div><a class="calendar-link" href="#yearCalendar">Browse your calendar <span aria-hidden="true">↓</span></a></div>
  </section>
  <div class="journal-status" aria-live="polite"><p id="accessHint">Loading cloud records…</p><button id="retryLoad" type="button" class="subtle-btn" hidden>Retry connection</button><button id="returnToday" type="button" class="subtle-btn" hidden>↩ Return to today</button></div>
  <div class="daily-layout">
    <div class="daily-main">
    <section class="task-card" aria-labelledby="boardTitle">
      <div class="section-top"><div><h2 id="boardTitle">Today's checklist</h2><p id="boardDescription">Each day keeps its own tasks and notes.</p></div><button id="editTasks" type="button" class="subtle-btn" disabled>✎ Edit tasks</button></div>
      <div id="taskList" class="list" aria-busy="true">{DEFAULT_TASKS.map((task) => (<button type="button" class="task" disabled><span class="checkbox" aria-hidden="true"></span><span class="task-words"><span class="task-title">{task.title}</span><span class="task-detail">{task.detail}</span></span></button>))}</div>
      <div class="board-bottom"><p id="footerStatus" role="status">Connecting to the journal…</p><button class="text-btn" id="retryChecks" type="button" hidden>Retry saving checkmarks</button><button type="button" id="resetDay" class="subtle-btn" disabled>↺ Reset checkmarks</button></div>
    </section>
    <section class="notes"><div class="notes-heading"><label for="dayNote">A note to myself</label><span>Reflect & plan</span></div><textarea id="dayNote" maxlength="10000" rows="5" placeholder="What did you learn? What should you focus on next?" disabled></textarea><div class="note-foot"><p id="saveHint" class="save-hint" role="status">Daily notes are saved separately.</p><button id="retryNote" class="text-btn" type="button" hidden>Retry saving</button></div></section>
    </div>
    <aside class="daily-side" aria-label="Progress overview">
      <section class="progress-card" aria-labelledby="progressLabel"><h2 class="card-label" id="progressLabel">Today's progress</h2><div class="progress-wrap"><div class="ring" id="progressRing" role="img" aria-label="0 percent completed"><div class="ring-inner"><div class="percent" id="percent">0%</div><div class="ring-sub">Complete</div></div></div><div class="progress-side"><strong id="doneCount">0 / {DEFAULT_TASKS.length}</strong><p id="motivation">Your first step starts here.</p></div></div><div class="progress-line"><div id="progressFill" class="progress-fill"></div></div></section>
      <section class="weekly" aria-labelledby="weeklyTitle"><div class="weekly-head"><h2 id="weeklyTitle">Last 7 days</h2><span>Completion rate</span></div><div class="week-bars" id="weekBars"></div><p class="week-hint">Select a day to revisit its checklist and notes.</p></section>
    </aside>
  </div>
  <section class="year-calendar" id="yearCalendar" aria-labelledby="calendarTitle">
    <div class="calendar-top"><div><div class="eyebrow">THE DAILY ARCHIVE</div><h2 id="calendarTitle">Your year at a glance</h2><p>Every checklist and note, organized by date.</p></div><div class="year-switcher" aria-label="Choose calendar year"><button id="previousYear" class="icon-btn" type="button" aria-label="Previous year">←</button><strong id="calendarYear">—</strong><button id="nextYear" class="icon-btn" type="button" aria-label="Next year">→</button></div></div>
    <div class="year-summary" id="yearSummary" aria-live="polite"><span>No recorded days yet.</span></div>
    <div class="calendar-legend" aria-label="Calendar color legend"><span><i class="legend-color no-record"></i>No record</span><span><i class="legend-color progress-zero"></i>Recorded</span><span><i class="legend-color progress-partial"></i>In progress</span><span><i class="legend-color progress-full"></i>Complete</span><span><i class="legend-color today-mark"></i>Today</span></div>
    <div class="month-grid" id="yearMonths" aria-busy="true"></div><p class="calendar-foot">Calendar dates and day boundaries use Beijing time. Blank dates mean no saved record. Each saved day keeps its own task list.</p>
  </section>
  <p class="shortcut-hint">Owner shortcut: press <kbd>1</kbd>–<kbd>9</kbd> to toggle a task. Use the header to switch theme or enter fullscreen.</p>
  <noscript><p class="no-script">Enable JavaScript to load the cloud journal and choose calendar dates.</p></noscript>
  <dialog id="taskEditor" aria-labelledby="editTitle"><form id="taskEditorForm"><div class="dialog-head"><div><h2 id="editTitle">Customize this day's checklist</h2><p id="editorDate">Changes preserve every other day's saved tasks.</p></div><button type="button" class="icon-btn" id="closeTaskEditor" aria-label="Close task editor">×</button></div><div class="dialog-body"><div id="editRows"></div><label class="future-template"><input type="checkbox" id="applyToFuture" /><span>Also use these tasks for days with no saved record.<small id="templateHint">Existing daily records keep their own task lists.</small></span></label><p id="editorError" role="alert" hidden></p></div><div class="dialog-foot"><button type="button" class="subtle-btn" id="addTask">＋ Add a task</button><div class="dialog-actions"><button type="button" class="subtle-btn" id="cancelTaskEditor">Cancel</button><button type="submit" class="filled-btn" id="saveTasks">Save changes</button></div></div></form></dialog>
  <dialog id="resetDialog" aria-labelledby="resetTitle"><form id="resetForm"><div class="dialog-head"><div><h2 id="resetTitle">Reset this day's checkmarks?</h2><p id="resetDescription">The tasks and note will be kept.</p></div></div><div class="dialog-foot"><button type="button" class="subtle-btn" id="cancelReset">Cancel</button><button type="submit" class="filled-btn" id="confirmReset">Reset checkmarks</button></div></form></dialog>
  <dialog id="noteConflict" aria-labelledby="conflictTitle"><div class="dialog-head"><div><h2 id="conflictTitle">Review a note conflict</h2><p>Another device saved this day while you were writing. Compare both versions before choosing what to keep.</p></div></div><div class="dialog-body"><label class="conflict-label" for="cloudNote">Latest note in the cloud</label><textarea id="cloudNote" class="conflict-note" rows="5" readonly></textarea><label class="conflict-label" for="localNote">Your unsaved draft</label><textarea id="localNote" class="conflict-note" rows="5" readonly></textarea><p id="conflictError" role="alert" hidden></p></div><div class="dialog-foot"><button type="button" id="cancelConflict" class="subtle-btn">Keep reviewing</button><div class="dialog-actions"><button type="button" id="useCloudNote" class="subtle-btn">Use cloud note</button><button type="button" id="keepDraftNote" class="filled-btn">Save my draft</button></div></div></dialog>
  <div id="journalToast" class="journal-toast" role="status" aria-live="polite"></div>
</div>
<script>import '../scripts/checklist';</script>
<style>
  .daily-board { padding-bottom:24px; }
  .welcome { display:flex; align-items:center; justify-content:space-between; gap:32px; padding:34px 0 26px; }
  .welcome-copy { min-width:0; }
  .welcome .eyebrow { font-size:14px; letter-spacing:.075em; line-height:1.6; }
  .welcome h1 { margin:9px 0 10px; font-size:clamp(30px,3vw,38px); line-height:1.2; font-weight:750; letter-spacing:-.035em; }
  .welcome h1 > span { color:var(--primary); }
  .welcome h1 .greeting { color:var(--text); }
  .intro { margin:0; color:var(--muted); font-size:17px; line-height:1.65; }
  .welcome-actions { flex:0 1 330px; min-width:220px; display:flex; flex-direction:column; align-items:flex-end; gap:12px; text-align:right; }
  .day-pill { display:block; padding:0; border:0; border-radius:0; background:none; white-space:normal; }
  .day-pill strong { display:block; font-size:17px; font-weight:650; }
  .day-pill small { display:block; margin-top:4px; font-size:14px; color:var(--muted); line-height:1.55; }
  .calendar-link { display:inline-flex; align-items:center; gap:12px; color:var(--primary); font-size:15px; font-weight:650; text-decoration:none; min-height:36px; }
  .calendar-link:hover { text-decoration:underline; text-underline-offset:4px; }
  .calendar-link span { font-size:20px; }
  .journal-status { display:flex; flex-wrap:wrap; align-items:center; gap:10px 16px; margin:0 0 20px; }
  .journal-status p { flex:1; min-width:180px; margin:0; color:var(--muted); font-size:14px; line-height:1.6; }
  .daily-layout { display:grid; grid-template-columns:minmax(0,1fr) 320px; gap:28px; align-items:start; }
  .daily-main { min-width:0; padding:28px 30px; background:var(--surface); border:1px solid var(--line); border-radius:16px; }
  .task-card { padding:0; }
  .section-top { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; }
  .section-top h2 { margin:0; font-size:25px; line-height:1.35; letter-spacing:-.025em; font-weight:720; }
  .section-top p { margin:6px 0 0; font-size:15px; color:var(--muted); line-height:1.65; }
  .section-top button { flex-shrink:0; }
  .list { margin-top:26px; }
  .daily-board :global(.group) { margin-top:26px; }
  .daily-board :global(.group:first-child) { margin-top:0; }
  .daily-board :global(.group-head) { display:flex; justify-content:space-between; align-items:center; gap:12px; padding-bottom:9px; margin:0; border-bottom:1px solid var(--line); color:var(--muted); text-transform:uppercase; letter-spacing:.075em; font-size:14px; font-weight:650; }
  .daily-board :global(.group-name) { display:flex; align-items:center; gap:9px; min-width:0; }
  .daily-board :global(.group-dot) { width:7px; height:7px; flex-shrink:0; border-radius:50%; background:var(--violet); }
  .daily-board :global(.group-dot.english) { background:var(--teal); }
  .daily-board :global(.group-dot.development) { background:var(--orange); }
  .daily-board :global(.group-count) { font-size:14px; font-weight:550; letter-spacing:0; white-space:nowrap; font-variant-numeric:tabular-nums; }
  .daily-board :global(.task) { -webkit-tap-highlight-color:transparent; display:flex; align-items:center; gap:15px; width:100%; min-height:82px; padding:15px 6px; margin:0; text-align:left; color:var(--text); border:0; border-bottom:1px solid var(--line); border-radius:0; background:transparent; transition:background .15s; }
  .daily-board :global(.task:last-child) { border-bottom-color:transparent; }
  .daily-board :global(.task:hover:not(:disabled)) { background:var(--surface-2); }
  .daily-board :global(.task:active) { transform:none; }
  .daily-board :global(.task:disabled) { cursor:default; opacity:1; }
  .daily-board :global(.task:focus-visible) { outline-offset:-3px; }
  .daily-board :global(.checkbox) { display:grid; place-items:center; flex:0 0 25px; width:25px; height:25px; border:1.5px solid var(--dim); border-radius:6px; color:var(--surface); font-size:18px; line-height:1; }
  .daily-board :global(.task.checked .checkbox) { background:var(--teal); border-color:var(--teal); color:var(--surface); }
  .daily-board :global(.task-words) { flex:1; min-width:0; }
  .daily-board :global(.task-title) { display:block; font-size:18px; font-weight:650; line-height:1.45; overflow-wrap:anywhere; }
  .daily-board :global(.task-detail) { display:block; margin-top:3px; color:var(--muted); font-size:17px; line-height:1.6; overflow-wrap:anywhere; }
  .daily-board :global(.task.checked .task-title) { color:var(--muted); text-decoration:line-through; text-decoration-thickness:1px; }
  .daily-board :global(.task-index) { padding-left:3px; color:var(--dim); font-size:14px; font-weight:500; font-variant-numeric:tabular-nums; }
  .board-bottom { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-top:18px; padding-top:18px; border-top:1px solid var(--line); }
  .board-bottom p { flex:1; min-width:170px; margin:0; color:var(--muted); font-size:14px; line-height:1.65; }
  .daily-side { display:flex; flex-direction:column; gap:0; position:sticky; top:24px; min-width:0; padding:24px; background:var(--surface); border:1px solid var(--line); border-radius:16px; }
  .progress-card { padding:0; }
  .card-label { margin:0; color:var(--text); font-size:18px; line-height:1.4; font-weight:650; text-transform:none; letter-spacing:-.015em; }
  .progress-wrap { display:flex; align-items:center; gap:18px; margin-top:22px; }
  .ring { display:grid; place-items:center; flex:0 0 108px; width:108px; height:108px; border-radius:50%; background:conic-gradient(var(--teal) var(--p,0%),var(--surface-3) 0%); }
  .ring-inner { display:flex; flex-direction:column; align-items:center; justify-content:center; width:90px; height:90px; border-radius:50%; background:var(--surface); }
  .percent { font-size:28px; font-weight:720; letter-spacing:-.05em; font-variant-numeric:tabular-nums; line-height:1.25; }
  .ring-sub { margin-top:2px; font-size:14px; font-weight:500; color:var(--muted); }
  .progress-side { flex:1; min-width:0; overflow-wrap:anywhere; }
  .progress-side strong { font-size:24px; font-weight:650; letter-spacing:-.025em; font-variant-numeric:tabular-nums; }
  .progress-side p { margin:5px 0 0; color:var(--muted); font-size:14px; line-height:1.65; }
  .progress-line { height:4px; margin-top:22px; overflow:hidden; border-radius:4px; background:var(--surface-3); }
  .progress-fill { height:100%; width:0%; border-radius:4px; background:var(--teal); transition:width .2s; }
  .weekly { margin-top:24px; padding:24px 0 0; border-top:1px solid var(--line); }
  .weekly-head { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px 10px; }
  .weekly-head h2 { margin:0; font-size:18px; font-weight:650; letter-spacing:-.015em; }
  .weekly-head span { font-size:14px; color:var(--muted); }
  .week-bars { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:7px; align-items:end; margin-top:20px; }
  .daily-board :global(.week-item) { display:flex; flex-direction:column; align-items:center; gap:7px; min-width:0; min-height:116px; padding:3px 0; border:0; border-radius:5px; background:none; color:var(--muted); font-size:14px; }
  .daily-board :global(.week-item:hover) { background:var(--surface-2); }
  .daily-board :global(.week-item[aria-current="date"]) { color:var(--teal); font-weight:650; }
  .daily-board :global(.bar-value) { font-size:14px; font-variant-numeric:tabular-nums; }
  .daily-board :global(.bar-track) { display:flex; align-items:flex-end; overflow:hidden; height:64px; width:min(100%,22px); border-radius:4px; background:var(--surface-3); }
  .daily-board :global(.bar-fill) { width:100%; border-radius:4px; background:var(--violet); }
  .daily-board :global(.week-item[aria-current="date"] .bar-fill) { background:var(--teal); }
  .week-hint { margin:13px 0 0; color:var(--muted); font-size:14px; line-height:1.65; }
  .notes { padding:24px 0 0; margin-top:26px; border-top:1px solid var(--line); }
  .notes-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:6px 16px; margin-bottom:15px; }
  .notes label { display:block; margin:0; font-size:22px; line-height:1.4; font-weight:650; letter-spacing:-.02em; }
  .notes-heading > span { color:var(--muted); font-size:14px; }
  .notes textarea { display:block; width:100%; min-height:158px; resize:vertical; padding:16px 18px; color:var(--text); background:var(--surface-2); border:1px solid var(--line); border-radius:8px; font-size:17px; line-height:1.8; }
  .notes textarea::placeholder { color:var(--muted); }
  .notes textarea:disabled { opacity:1; cursor:default; }
  .note-foot { display:flex; align-items:flex-start; flex-wrap:wrap; gap:8px 12px; margin-top:10px; }
  .save-hint { flex:1; min-width:140px; margin:0; color:var(--muted); font-size:14px; line-height:1.65; }
  .text-btn { padding:0; min-height:24px; color:var(--primary); background:none; border:0; font-size:14px; white-space:nowrap; text-decoration:underline; text-underline-offset:3px; }
  .year-calendar { padding:32px 0 0; margin-top:38px; border-top:1px solid var(--line); scroll-margin-top:24px; }
  .calendar-top { display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .calendar-top .eyebrow { font-size:14px; letter-spacing:.075em; }
  .calendar-top h2 { margin:6px 0 7px; font-size:29px; line-height:1.35; font-weight:720; letter-spacing:-.03em; }
  .calendar-top p { margin:0; color:var(--muted); font-size:17px; line-height:1.65; }
  .year-switcher { display:flex; align-items:center; gap:14px; }
  .year-switcher strong { min-width:54px; text-align:center; font-size:22px; font-weight:650; font-variant-numeric:tabular-nums; }
  .year-summary { display:flex; flex-wrap:wrap; gap:14px 30px; margin-top:18px; padding:18px 0; border-bottom:1px solid var(--line); color:var(--muted); font-size:15px; }
  .daily-board :global(.year-summary strong) { margin-right:6px; color:var(--text); font-size:20px; font-weight:650; font-variant-numeric:tabular-nums; }
  .calendar-legend { display:flex; flex-wrap:wrap; gap:10px 18px; padding:18px 0 26px; color:var(--muted); font-size:14px; }
  .calendar-legend > span { display:flex; align-items:center; gap:7px; }
  .legend-color { display:inline-block; flex-shrink:0; width:12px; height:12px; border:1px solid var(--line); border-radius:3px; background:var(--surface); }
  .legend-color.progress-zero { background:var(--surface-3); }
  .legend-color.progress-partial { background:var(--primary-soft); border-color:var(--primary); }
  .legend-color.progress-full { background:var(--teal); border-color:var(--teal); }
  .legend-color.today-mark { border:2px solid var(--primary); }
  .month-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:32px; }
  .daily-board :global(.calendar-month) { min-width:0; }
  .daily-board :global(.calendar-month h3) { margin:0 0 12px; font-size:18px; font-weight:650; letter-spacing:-.01em; }
  .daily-board :global(.month-weekdays), .daily-board :global(.month-days) { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:4px; }
  .daily-board :global(.month-weekdays) { margin-bottom:6px; }
  .daily-board :global(.month-weekdays span) { color:var(--muted); text-align:center; font-size:14px; }
  .daily-board :global(.calendar-day) { position:relative; width:100%; min-width:0; min-height:32px; aspect-ratio:1; padding:0; border:1px solid var(--line); border-radius:5px; background:var(--surface); color:var(--muted); font-size:14px; font-variant-numeric:tabular-nums; }
  .daily-board :global(.calendar-day.recorded) { background:var(--surface-3); color:var(--text); }
  .daily-board :global(.calendar-day.partial) { background:var(--primary-soft); color:var(--primary); border-color:var(--primary-soft); }
  .daily-board :global(.calendar-day.complete) { background:var(--teal); color:var(--surface); }
  .daily-board :global(.calendar-day.today) { border:2px solid var(--primary); }
  .daily-board :global(.calendar-day[aria-pressed="true"]) { outline:2px solid var(--text); outline-offset:2px; z-index:1; }
  .daily-board :global(.calendar-day.future) { opacity:.65; }
  .daily-board :global(.calendar-day:hover) { border-color:var(--primary); color:var(--text); }
  .daily-board :global(.calendar-day.complete:hover) { color:var(--surface); }
  .daily-board :global(.calendar-day.has-note::after) { content:""; position:absolute; width:3px; height:3px; right:3px; bottom:3px; border-radius:50%; background:currentColor; }
  .calendar-foot { margin:28px 0 0; padding-top:18px; border-top:1px solid var(--line); color:var(--muted); font-size:14px; line-height:1.75; }
  .shortcut-hint { margin:18px 0 0; color:var(--muted); font-size:14px; line-height:1.8; }
  .shortcut-hint kbd { padding:2px 5px; border:1px solid var(--line); border-radius:4px; background:var(--surface); font:inherit; font-weight:600; }
  dialog { width:min(680px,calc(100% - 24px)); max-height:calc(100dvh - 32px); padding:0; color:var(--text); background:var(--surface); border:1px solid var(--line); border-radius:14px; box-shadow:0 24px 70px #0003; }
  dialog::backdrop { background:rgba(13,30,24,.55); }
  .dialog-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:24px; border-bottom:1px solid var(--line); }
  .dialog-head > div { min-width:0; }
  .dialog-head .icon-btn { flex-shrink:0; }
  .dialog-head h2 { margin:0 0 8px; font-size:23px; font-weight:650; line-height:1.35; letter-spacing:-.025em; }
  .dialog-head p { margin:0; color:var(--muted); font-size:16px; line-height:1.65; }
  .dialog-body { max-height:min(58vh,540px); overflow:auto; padding:22px 24px; }
  .daily-board :global(.edit-entry) { display:grid; grid-template-columns:minmax(0,1fr) 130px 42px; gap:8px; margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--line); }
  .daily-board :global(.edit-fields) { display:flex; flex-direction:column; gap:8px; }
  .daily-board :global(.editor-input) { min-width:0; width:100%; padding:11px 12px; border:1px solid var(--line); border-radius:6px; background:var(--surface-2); color:var(--text); font-size:16px; }
  .daily-board :global(.editor-select) { height:45px; }
  .daily-board :global(.delete-task) { height:45px; border:1px solid var(--line); border-radius:6px; background:var(--surface-2); color:var(--orange); font-size:22px; }
  .future-template { display:flex; align-items:flex-start; gap:11px; color:var(--text); font-size:16px; line-height:1.65; }
  .future-template input { width:18px; height:18px; flex-shrink:0; margin-top:4px; accent-color:var(--primary); }
  .future-template small { display:block; margin-top:5px; color:var(--muted); font-size:14px; }
  #editorError { margin:15px 0 0; color:var(--orange); font-size:16px; line-height:1.65; }
  .dialog-foot { display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; padding:18px 24px; border-top:1px solid var(--line); }
  .dialog-actions { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:9px; }
  .journal-toast { position:fixed; bottom:24px; right:24px; z-index:80; max-width:min(400px,calc(100vw - 32px)); padding:12px 16px; border-radius:8px; background:var(--text); color:var(--bg); box-shadow:var(--shadow); font-size:15px; line-height:1.6; font-weight:600; opacity:0; transform:translateY(10px); transition:opacity .2s,transform .2s; pointer-events:none; }
  .journal-toast.show { opacity:1; transform:translateY(0); }
  .daily-board :global(.empty-tasks), .no-script { color:var(--muted); font-size:17px; line-height:1.75; }
  .conflict-label { display:block; margin:0 0 9px; font-size:16px; font-weight:650; }

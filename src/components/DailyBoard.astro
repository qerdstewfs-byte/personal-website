---
import { DEFAULT_TASKS } from '../lib/journal';
---

<div id="dailyBoard" class="daily-board">
  <section class="welcome">
    <div><div class="eyebrow" id="dayLabel">DAILY JOURNAL · BEIJING TIME</div><h1><span id="greeting" class="greeting">Make today count</span><span>.</span></h1><p class="intro">Research, learning, and a little progress every day.</p></div>
    <div class="day-pill"><span class="day-pill-dot" aria-hidden="true"></span><div><strong id="selectedDayText">Today</strong><small id="selectedDaySub">Dates follow Asia/Shanghai · UTC+8</small></div></div>
  </section>
  <div class="journal-status" aria-live="polite"><p id="accessHint">Loading cloud records…</p><button id="retryLoad" type="button" class="subtle-btn" hidden>Retry connection</button><button id="returnToday" type="button" class="subtle-btn" hidden>↩ Return to today</button></div>
  <div class="daily-layout">
    <section class="card task-card" aria-labelledby="boardTitle">
      <div class="section-top"><div><h2 id="boardTitle">Today's checklist</h2><p id="boardDescription">Each day keeps its own tasks and notes.</p></div><button id="editTasks" type="button" class="subtle-btn" disabled>✎ Edit tasks</button></div>
      <div id="taskList" class="list" aria-busy="true">{DEFAULT_TASKS.map((task) => (<button type="button" class="task" disabled><span class="checkbox" aria-hidden="true"></span><span class="task-words"><span class="task-title">{task.title}</span><span class="task-detail">{task.detail}</span></span></button>))}</div>
      <div class="board-bottom"><p id="footerStatus" role="status">Connecting to the journal…</p><button class="text-btn" id="retryChecks" type="button" hidden>Retry saving checkmarks</button><button type="button" id="resetDay" class="subtle-btn" disabled>↺ Reset checkmarks</button></div>
    </section>
    <aside class="daily-side" aria-label="Progress and notes">
      <section class="card progress-card" aria-labelledby="progressLabel"><h2 class="card-label" id="progressLabel">Today's progress</h2><div class="progress-wrap"><div class="ring" id="progressRing" role="img" aria-label="0 percent completed"><div class="ring-inner"><div class="percent" id="percent">0%</div><div class="ring-sub">COMPLETE</div></div></div><div class="progress-side"><strong id="doneCount">0 / {DEFAULT_TASKS.length}</strong><p id="motivation">Your first step starts here.</p></div></div><div class="progress-line"><div id="progressFill" class="progress-fill"></div></div></section>
      <section class="card weekly" aria-labelledby="weeklyTitle"><div class="weekly-head"><h2 id="weeklyTitle">Last 7 days</h2><span>Completion rate</span></div><div class="week-bars" id="weekBars"></div><p class="week-hint">Seven days ending on the selected date. Click a bar to read that day.</p></section>
      <section class="card notes"><label for="dayNote">A note to myself</label><textarea id="dayNote" maxlength="10000" rows="5" placeholder="What did you learn? What should you focus on next?" disabled></textarea><div class="note-foot"><p id="saveHint" class="save-hint" role="status">Daily notes are saved separately.</p><button id="retryNote" class="text-btn" type="button" hidden>Retry saving</button></div></section>
    </aside>
  </div>
  <section class="card year-calendar" aria-labelledby="calendarTitle">
    <div class="calendar-top"><div><div class="eyebrow">A YEAR OF SMALL STEPS</div><h2 id="calendarTitle">Your year, remembered.</h2><p>Choose any date to revisit its checklist and notes.</p></div><div class="year-switcher" aria-label="Choose calendar year"><button id="previousYear" class="icon-btn" type="button" aria-label="Previous year">←</button><strong id="calendarYear">—</strong><button id="nextYear" class="icon-btn" type="button" aria-label="Next year">→</button></div></div>
    <div class="year-summary" id="yearSummary" aria-live="polite"><span>No recorded days yet.</span></div>
    <div class="calendar-legend" aria-label="Calendar color legend"><span><i class="legend-color no-record"></i>No record</span><span><i class="legend-color progress-zero"></i>Recorded</span><span><i class="legend-color progress-partial"></i>In progress</span><span><i class="legend-color progress-full"></i>Complete</span><span><i class="legend-color today-mark"></i>Today</span></div>
    <div class="month-grid" id="yearMonths" aria-busy="true"></div><p class="calendar-foot">Calendar dates and day boundaries use Beijing time. Blank dates mean no saved record. Each saved day keeps its own task list.</p>
  </section>
  <p class="shortcut-hint">Owner shortcut: press <kbd>1</kbd>–<kbd>9</kbd> to toggle a task. Use the header to switch theme or enter fullscreen.</p>
  <noscript><p class="no-script">Enable JavaScript to load the cloud journal and choose calendar dates.</p></noscript>
  <dialog id="taskEditor" aria-labelledby="editTitle"><form id="taskEditorForm"><div class="dialog-head"><div><h2 id="editTitle">Customize this day's checklist</h2><p id="editorDate">Changes preserve every other day's saved tasks.</p></div><button type="button" class="icon-btn" id="closeTaskEditor" aria-label="Close task editor">×</button></div><div class="dialog-body"><div id="editRows"></div><label class="future-template"><input type="checkbox" id="applyToFuture" /><span>Also use these tasks for days with no saved record.<small id="templateHint">Existing daily records keep their own task lists.</small></span></label><p id="editorError" role="alert" hidden></p></div><div class="dialog-foot"><button type="button" class="subtle-btn" id="addTask">＋ Add a task</button><div class="dialog-actions"><button type="button" class="subtle-btn" id="cancelTaskEditor">Cancel</button><button type="submit" class="filled-btn" id="saveTasks">Save changes</button></div></div></form></dialog>
  <dialog id="resetDialog" aria-labelledby="resetTitle"><form id="resetForm"><div class="dialog-head"><div><h2 id="resetTitle">Reset this day's checkmarks?</h2><p id="resetDescription">The tasks and note will be kept.</p></div></div><div class="dialog-foot"><button type="button" class="subtle-btn" id="cancelReset">Cancel</button><button type="submit" class="filled-btn" id="confirmReset">Reset checkmarks</button></div></form></dialog>
  <dialog id="noteConflict" aria-labelledby="conflictTitle"><div class="dialog-head"><div><h2 id="conflictTitle">Review a note conflict</h2><p>Another device saved this day while you were writing. Compare both versions before choosing what to keep.</p></div></div><div class="dialog-body"><label class="conflict-label" for="cloudNote">Latest note in the cloud</label><textarea id="cloudNote" class="conflict-note" rows="5" readonly></textarea><label class="conflict-label" for="localNote">Your unsaved draft</label><textarea id="localNote" class="conflict-note" rows="5" readonly></textarea><p id="conflictError" role="alert" hidden></p></div><div class="dialog-foot"><button type="button" id="cancelConflict" class="subtle-btn">Keep reviewing</button><div class="dialog-actions"><button type="button" id="useCloudNote" class="subtle-btn">Use cloud note</button><button type="button" id="keepDraftNote" class="filled-btn">Save my draft</button></div></div></dialog>
  <div id="journalToast" class="journal-toast" role="status" aria-live="polite"></div>
</div>
<script>import '../scripts/checklist';</script>
<style>
  .daily-board { padding-bottom:20px; }
  .welcome { padding:36px 0 24px; display:flex; align-items:center; justify-content:space-between; gap:22px; }
  .welcome h1 { margin:11px 0 10px; font-size:clamp(31px,4vw,54px); letter-spacing:-.055em; font-weight:850; line-height:1.08; }
  .welcome h1 > span { color:var(--primary); } .welcome h1 .greeting { color:var(--text); }
  .intro { color:var(--muted); font-size:18px; margin:0; line-height:1.6; }
  .day-pill { display:flex; align-items:center; gap:12px; padding:14px 18px; background:var(--surface); border:1px solid var(--line); border-radius:15px; white-space:nowrap; }
  .day-pill strong { font-size:17px; } .day-pill small { display:block; font-size:14px; color:var(--muted); margin-top:5px; }
  .day-pill-dot { width:11px; height:11px; border-radius:50%; background:var(--teal); box-shadow:0 0 0 6px var(--primary-soft); }
  .journal-status { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:20px; } .journal-status p { flex:1; color:var(--muted); font-size:15px; line-height:1.65; margin:0; }
  .daily-layout { display:grid; grid-template-columns:minmax(0,1.68fr) minmax(305px,.82fr); gap:22px; align-items:start; } .task-card { padding:clamp(20px,3vw,32px); }
  .section-top { display:flex; align-items:start; justify-content:space-between; gap:14px; } .section-top h2 { margin:0; font-size:21px; letter-spacing:-.025em; } .section-top p { margin:7px 0 0; font-size:15px; color:var(--muted); line-height:1.5; } .section-top button { flex-shrink:0; }
  .list { margin-top:22px; } .daily-board :global(.group) { margin-top:22px; } .daily-board :global(.group:first-child) { margin-top:0; }
  .daily-board :global(.group-head) { display:flex; justify-content:space-between; align-items:center; gap:12px; text-transform:uppercase; letter-spacing:.16em; font-weight:850; font-size:13px; color:var(--dim); margin-bottom:10px; }
  .daily-board :global(.group-name) { display:flex; gap:9px; align-items:center; } .daily-board :global(.group-dot) { width:8px; height:8px; border-radius:50%; background:var(--violet); } .daily-board :global(.group-dot.english) { background:var(--teal); } .daily-board :global(.group-dot.development) { background:var(--orange); } .daily-board :global(.group-count) { letter-spacing:.02em; font-size:14px; font-variant-numeric:tabular-nums; }
  .daily-board :global(.task) { -webkit-tap-highlight-color:transparent; border:1px solid var(--line); border-radius:15px; background:var(--surface-2); width:100%; min-height:75px; display:flex; text-align:left; align-items:center; gap:16px; padding:13px 17px; color:var(--text); margin-top:8px; transition:background .17s,border-color .17s; }
  .daily-board :global(.task:hover:not(:disabled)) { background:var(--surface-3); border-color:var(--primary); } .daily-board :global(.task:disabled) { opacity:1; cursor:default; }
  .daily-board :global(.checkbox) { flex:0 0 26px; width:26px; height:26px; border:2px solid var(--dim); border-radius:9px; display:grid; place-items:center; color:#fff; font-size:19px; line-height:1; } .daily-board :global(.task.checked .checkbox) { background:var(--teal); border-color:var(--teal); color:var(--bg); }
  .daily-board :global(.task-words) { flex:1; min-width:0; } .daily-board :global(.task-title) { display:block; font-weight:750; font-size:18px; line-height:1.3; overflow-wrap:anywhere; } .daily-board :global(.task-detail) { display:block; margin-top:6px; font-size:15px; color:var(--muted); line-height:1.5; overflow-wrap:anywhere; } .daily-board :global(.task.checked .task-title) { color:var(--muted); text-decoration:line-through; text-decoration-thickness:1px; } .daily-board :global(.task-index) { font-size:14px; font-weight:750; color:var(--dim); font-variant-numeric:tabular-nums; padding-left:5px; }
  .board-bottom { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:13px; border-top:1px solid var(--line); margin-top:25px; padding-top:20px; } .board-bottom p { flex:1; min-width:160px; margin:0; font-size:15px; color:var(--muted); line-height:1.6; }
  .daily-side { display:flex; flex-direction:column; gap:20px; } .progress-card { padding:26px; } .card-label { margin:0; text-transform:uppercase; font-size:13px; color:var(--dim); font-weight:850; letter-spacing:.19em; }
  .progress-wrap { display:flex; align-items:center; gap:24px; margin-top:27px; } .ring { width:138px; height:138px; flex:0 0 138px; border-radius:50%; display:grid; place-items:center; background:conic-gradient(var(--teal) var(--p,0%),var(--surface-3) 0%); } .ring-inner { width:112px; height:112px; border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--surface); } .percent { font-size:34px; font-weight:850; letter-spacing:-.05em; font-variant-numeric:tabular-nums; } .ring-sub { font-size:13px; color:var(--muted); font-weight:700; }
  .progress-side strong { font-size:27px; font-weight:850; letter-spacing:-.03em; } .progress-side p { margin:8px 0 0; color:var(--muted); font-size:15px; line-height:1.6; } .progress-line { height:7px; border-radius:20px; overflow:hidden; background:var(--surface-3); margin-top:27px; } .progress-fill { height:100%; width:0%; background:linear-gradient(90deg,var(--primary),var(--teal)); border-radius:20px; transition:width .35s; }
  .weekly { padding:25px 26px; } .weekly-head { display:flex; justify-content:space-between; align-items:center; gap:10px; } .weekly-head h2 { font-size:18px; margin:0; } .weekly-head span { font-size:14px; color:var(--muted); } .week-bars { display:grid; grid-template-columns:repeat(7,1fr); gap:10px; align-items:end; margin-top:22px; }
  .daily-board :global(.week-item) { display:flex; flex-direction:column; align-items:center; gap:7px; min-width:0; padding:0; border:0; background:none; color:var(--dim); font-size:13px; } .daily-board :global(.week-item[aria-current="date"]) { color:var(--teal); } .daily-board :global(.bar-value) { font-variant-numeric:tabular-nums; font-size:13px; } .daily-board :global(.bar-track) { height:82px; width:min(100%,26px); border-radius:9px; background:var(--surface-3); display:flex; align-items:end; overflow:hidden; } .daily-board :global(.bar-fill) { width:100%; background:linear-gradient(180deg,var(--primary),var(--violet)); border-radius:8px; } .daily-board :global(.week-item[aria-current="date"] .bar-fill) { background:var(--teal); }
  .week-hint { margin:16px 0 0; color:var(--muted); font-size:14px; line-height:1.65; } .notes { padding:25px 26px; } .notes label { display:block; margin:0 0 13px; font-size:18px; font-weight:750; } .notes textarea { display:block; resize:vertical; width:100%; min-height:120px; background:var(--surface-2); color:var(--text); border:1px solid var(--line); border-radius:12px; padding:13px 14px; font-size:16px; line-height:1.65; } .notes textarea::placeholder { color:var(--dim); } .notes textarea:disabled { opacity:1; cursor:default; }
  .note-foot { display:flex; gap:12px; align-items:start; margin-top:10px; } .save-hint { margin:0; font-size:14px; color:var(--dim); line-height:1.65; } .text-btn { padding:0; border:0; background:none; color:var(--primary); font-size:14px; white-space:nowrap; text-decoration:underline; }
  .year-calendar { padding:clamp(20px,3vw,32px); margin-top:24px; } .calendar-top { display:flex; align-items:center; justify-content:space-between; gap:22px; } .calendar-top h2 { margin:10px 0 8px; font-size:29px; letter-spacing:-.045em; font-weight:780; } .calendar-top p { font-size:16px; margin:0; color:var(--muted); line-height:1.6; } .year-switcher { display:flex; gap:13px; align-items:center; } .year-switcher strong { font-variant-numeric:tabular-nums; font-size:22px; min-width:54px; text-align:center; }
  .year-summary { display:flex; flex-wrap:wrap; gap:24px; padding:22px 0; margin-top:12px; border-bottom:1px solid var(--line); color:var(--muted); font-size:15px; } .daily-board :global(.year-summary strong) { color:var(--text); font-weight:800; font-size:20px; margin-right:7px; font-variant-numeric:tabular-nums; }
  .calendar-legend { display:flex; gap:16px; flex-wrap:wrap; color:var(--muted); font-size:13px; padding:19px 0 22px; } .calendar-legend > span { display:flex; gap:6px; align-items:center; } .legend-color { display:inline-block; width:11px; height:11px; border-radius:3px; background:var(--surface-2); border:1px solid var(--line); } .legend-color.progress-zero { background:var(--surface-3); } .legend-color.progress-partial { background:var(--primary); border-color:var(--primary); } .legend-color.progress-full { background:var(--teal); border-color:var(--teal); } .legend-color.today-mark { border:2px solid var(--primary); }
  .month-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:24px 30px; } .daily-board :global(.calendar-month) { min-width:0; } .daily-board :global(.calendar-month h3) { margin:0 0 13px; font-size:16px; font-weight:780; } .daily-board :global(.month-weekdays), .daily-board :global(.month-days) { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:4px; } .daily-board :global(.month-weekdays) { margin-bottom:6px; } .daily-board :global(.month-weekdays span) { font-size:13px; text-align:center; color:var(--dim); }
  .daily-board :global(.calendar-day) { position:relative; padding:0; aspect-ratio:1; width:100%; border:1px solid transparent; border-radius:6px; background:var(--surface-2); color:var(--muted); font-variant-numeric:tabular-nums; font-size:13px; min-width:0; } .daily-board :global(.calendar-day.recorded) { background:var(--surface-3); color:var(--text); } .daily-board :global(.calendar-day.partial) { background:var(--primary-soft); color:var(--primary); border-color:var(--primary-soft); } .daily-board :global(.calendar-day.complete) { background:var(--teal); color:var(--bg); } .daily-board :global(.calendar-day.today) { border:2px solid var(--primary); } .daily-board :global(.calendar-day[aria-pressed="true"]) { outline:2px solid var(--text); outline-offset:2px; z-index:1; } .daily-board :global(.calendar-day.future) { opacity:.42; } .daily-board :global(.calendar-day:hover) { border-color:var(--primary); } .daily-board :global(.calendar-day.has-note::after) { content:""; position:absolute; height:3px; width:3px; border-radius:50%; right:3px; bottom:3px; background:currentColor; }
  .calendar-foot { margin:25px 0 0; padding-top:20px; border-top:1px solid var(--line); color:var(--dim); font-size:14px; line-height:1.7; } .shortcut-hint { color:var(--dim); font-size:14px; line-height:1.8; margin:20px 0 0; } .shortcut-hint kbd { font:inherit; font-weight:800; padding:3px 6px; border:1px solid var(--line); border-radius:5px; background:var(--surface); }
  dialog { border:1px solid var(--line); padding:0; border-radius:22px; width:min(660px,calc(100% - 28px)); max-height:calc(100vh - 42px); color:var(--text); background:var(--surface); box-shadow:0 30px 120px #0007; } dialog::backdrop { background:rgba(3,8,20,.72); backdrop-filter:blur(5px); } .dialog-head { padding:24px 26px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:start; gap:12px; } .dialog-head h2 { margin:0 0 8px; font-size:21px; letter-spacing:-.02em; } .dialog-head p { margin:0; font-size:15px; color:var(--muted); line-height:1.6; } .dialog-body { padding:22px 26px; max-height:min(58vh,540px); overflow:auto; }
  .daily-board :global(.edit-entry) { display:grid; grid-template-columns:minmax(0,1fr) 130px 39px; gap:8px; margin-bottom:16px; padding-bottom:16px; border-bottom:1px solid var(--line); } .daily-board :global(.edit-fields) { display:flex; flex-direction:column; gap:8px; } .daily-board :global(.editor-input) { width:100%; min-width:0; padding:11px 12px; background:var(--surface-2); border:1px solid var(--line); border-radius:10px; color:var(--text); font-size:15px; } .daily-board :global(.editor-select) { height:42px; } .daily-board :global(.delete-task) { height:42px; border:1px solid var(--line); background:var(--surface-2); color:var(--orange); border-radius:10px; font-size:22px; }
  .future-template { display:flex; gap:10px; align-items:start; color:var(--text); font-size:15px; line-height:1.6; } .future-template input { margin-top:3px; accent-color:var(--primary); } .future-template small { display:block; font-size:14px; color:var(--muted); } #editorError { font-size:15px; color:var(--orange); line-height:1.6; margin:15px 0 0; } .dialog-foot { padding:18px 26px; border-top:1px solid var(--line); display:flex; justify-content:space-between; flex-wrap:wrap; gap:12px; } .dialog-actions { display:flex; gap:9px; }
  .journal-toast { position:fixed; bottom:26px; right:26px; max-width:min(400px,calc(100vw - 40px)); background:var(--text); color:var(--bg); border-radius:12px; padding:12px 16px; box-shadow:var(--shadow); font-size:15px; line-height:1.6; font-weight:700; opacity:0; transform:translateY(10px); transition:opacity .2s,transform .2s; pointer-events:none; z-index:80; } .journal-toast.show { opacity:1; transform:translateY(0); } .daily-board :global(.empty-tasks), .no-script { color:var(--muted); font-size:16px; line-height:1.7; }
  .conflict-label { display:block; font-size:15px; font-weight:700; margin:0 0 9px; } .conflict-note { display:block; width:100%; resize:vertical; padding:12px; background:var(--surface-2); color:var(--text); border:1px solid var(--line); border-radius:10px; font-size:15px; line-height:1.7; margin-bottom:18px; } #conflictError { color:var(--orange); font-size:15px; line-height:1.6; }
  @media(min-width:1550px) { .daily-board :global(.task) { min-height:82px; } .daily-board :global(.task-title) { font-size:19px; } .daily-board :global(.task-detail) { font-size:16px; } }
  @media(max-width:1100px) { .month-grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media(max-width:960px) { .daily-layout { grid-template-columns:1fr; } .daily-side { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); } .notes { grid-column:1/-1; } .welcome { padding-top:24px; } }
  @media(max-width:640px) { .welcome { flex-direction:column; align-items:flex-start; gap:16px; } .day-pill { width:100%; white-space:normal; } .daily-side { display:flex; } .progress-wrap { justify-content:space-around; } .task-card { padding:18px; } .section-top { flex-wrap:wrap; } .section-top button { margin-top:3px; } .daily-board :global(.task) { min-height:70px; padding:12px; gap:12px; } .daily-board :global(.task-title) { font-size:17px; } .daily-board :global(.task-detail) { font-size:14px; } .calendar-top { flex-wrap:wrap; gap:18px; } .calendar-top h2 { font-size:26px; } .month-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px 18px; } .daily-board :global(.calendar-day) { font-size:13px; border-radius:5px; } .year-summary { gap:14px; } .daily-board :global(.year-summary strong) { font-size:18px; } .daily-board :global(.edit-entry) { grid-template-columns:minmax(0,1fr) 39px; } .daily-board :global(.edit-entry select) { grid-column:1; grid-row:2; } .daily-board :global(.edit-entry .delete-task) { grid-column:2; grid-row:1; } .dialog-body,.dialog-head,.dialog-foot { padding-left:17px; padding-right:17px; } }
  @media(max-width:360px) { .month-grid { gap:23px 10px; } .daily-board :global(.month-days), .daily-board :global(.month-weekdays) { gap:3px; } }
  .daily-board :global(.task-detail) { font-size:16px; line-height:1.6; }
  .daily-board :global(.calendar-day) { font-size:14px; min-height:32px; }
  .daily-board :global(.month-weekdays span) { font-size:13px; }
  .notes textarea, .daily-board :global(.editor-input), .conflict-note { font-size:16px; }
  .weekly-head { flex-wrap:wrap; }
  .progress-wrap { flex-wrap:wrap; }
  .progress-side { flex:1; min-width:85px; overflow-wrap:anywhere; }
  @media(max-width:800px) { .daily-side { display:flex; } }
  @media(max-width:520px) { .month-grid { grid-template-columns:1fr; } .daily-board :global(.calendar-day) { font-size:15px; min-height:36px; } .week-bars { gap:7px; } }
  @media(prefers-reduced-motion:reduce) { .progress-fill,.journal-toast,.daily-board :global(.task) { transition:none; } }
</style>

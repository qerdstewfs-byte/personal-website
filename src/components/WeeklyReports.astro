<section id="weeklyReports" aria-labelledby="weeklyTitle">
  <header class="page-heading">
    <div><p class="eyebrow">Research notebook</p><h1 id="weeklyTitle">Weekly Reports</h1></div>
    <button id="newReport" class="filled-btn" type="button" hidden>New report <span aria-hidden="true">＋</span></button>
  </header>
  <div class="weekly-layout">
    <aside class="weekly-index" aria-label="Report index">
      <div class="weekly-index-heading"><span>Reports</span><span id="reportCount">—</span></div>
      <nav id="reportList" aria-label="Weekly reports"></nav>
    </aside>
    <div class="weekly-main">
      <div id="weeklyMessage" class="weekly-message" role="status" aria-live="polite">Loading reports…</div>
      <button id="retryReports" class="subtle-btn" type="button" hidden>Retry</button>
      <div id="reportContent" hidden>
        <div class="report-toolbar">
          <div class="report-identity"><h2 id="reportLabel" lang="zh-CN"></h2><span id="reportState" class="report-state"></span></div>
          <div id="reportOwnerActions" class="report-actions" hidden>
            <button id="previewReport" class="subtle-btn" type="button" aria-pressed="false">Preview</button>
            <button id="saveReport" class="subtle-btn" type="button">Save draft</button>
            <button id="publishReport" class="filled-btn" type="button">Publish</button>
            <button id="unpublishReport" class="report-text-button" type="button" hidden>Unpublish</button>
            <button id="reloadReport" class="report-text-button" type="button" hidden>Reload saved</button>
          </div>
        </div>
        <p id="reportSaveStatus" class="report-save-status" role="status" aria-live="polite"></p>
        <form id="weeklyReportForm" autocomplete="off">
          <fieldset id="reportFields" class="report-fields">
            <div id="reportPaper" class="report-paper" lang="zh-CN"></div>
          </fieldset>
        </form>
        <footer class="report-export">
          <span id="exportHint">.docx</span>
          <button id="exportReport" class="subtle-btn" type="button">Export Word <span aria-hidden="true">↓</span></button>
        </footer>
      </div>
    </div>
  </div>
  <noscript><p>Enable JavaScript to view and edit weekly reports.</p></noscript>
</section>
<script src="../scripts/weekly-reports.ts"></script>
<style is:global>
  #weeklyReports{padding-bottom:16px}
  #weeklyReports .page-heading{align-items:center}
  #weeklyReports .weekly-layout{display:grid;grid-template-columns:205px minmax(0,1fr);gap:36px;border-top:1px solid var(--line-strong);padding-top:24px;min-height:52vh}
  #weeklyReports .weekly-index{border-right:1px solid var(--line);padding-right:22px;min-width:0}
  #weeklyReports .weekly-index-heading{display:flex;justify-content:space-between;gap:8px;padding:3px 0 16px;font-family:var(--mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim)}
  #weeklyReports #reportList{display:grid;gap:6px}
  #weeklyReports .report-index-item{display:block;width:100%;text-align:left;background:transparent;border:0;border-left:2px solid transparent;padding:11px 12px;color:var(--text);border-radius:0 6px 6px 0;line-height:1.45}
  #weeklyReports .report-index-item:hover{background:var(--surface-2)}
  #weeklyReports .report-index-item[aria-current="page"]{border-left-color:var(--primary);background:var(--primary-soft)}
  #weeklyReports .report-index-label{display:block;font-size:16px;font-weight:600}
  #weeklyReports .report-index-title{display:block;font-size:13px;color:var(--muted);margin-top:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #weeklyReports .report-index-meta{display:flex;gap:8px;flex-wrap:wrap;font-size:11px;color:var(--dim);margin-top:6px}
  #weeklyReports .weekly-main{min-width:0}
  #weeklyReports .weekly-message{color:var(--muted);font-size:16px;padding:20px 0}
  #weeklyReports .weekly-message:empty{display:none}
  #weeklyReports .weekly-message[data-error="true"]{color:var(--orange)}
  #weeklyReports .report-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;min-height:46px;margin-bottom:10px}
  #weeklyReports .report-identity{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
  #weeklyReports .report-identity h2{font:600 21px/1.3 var(--sans);margin:0}
  #weeklyReports .report-state{font-size:11px;color:var(--dim);padding:3px 7px;border:1px solid var(--line);border-radius:4px;line-height:1.4}
  #weeklyReports .report-actions{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
  #weeklyReports .report-actions button{font-size:12px;min-height:38px;padding:7px 10px}
  #weeklyReports .report-text-button{border:0;background:none;color:var(--muted);padding:7px 4px;text-decoration:underline;text-underline-offset:3px;font-size:12px;min-height:36px}
  #weeklyReports .report-save-status{font-size:12px;min-height:20px;color:var(--dim);margin:0 0 12px}
  #weeklyReports .report-save-status[data-error="true"]{color:var(--orange)}
  #weeklyReports .report-fields{border:0;padding:0;margin:0;min-width:0}
  #weeklyReports .report-paper{background:var(--surface);border:1px solid var(--line);box-shadow:var(--shadow);padding:40px clamp(20px,4vw,50px) 46px;min-height:720px;color:var(--text);font-family:'Times New Roman','SimSun','Songti SC',serif;font-size:18px;line-height:1.85}
  #weeklyReports .report-paper h2,#weeklyReports .report-paper h3{font-family:var(--sans),'Microsoft YaHei',sans-serif;font-size:19px;font-weight:650;line-height:1.6;letter-spacing:0;text-wrap:wrap;margin:27px 0 12px}
  #weeklyReports .report-paper h3{font-size:17px;margin-top:18px}
  #weeklyReports .report-paper .paper-title{display:block;width:100%;text-align:center;font-family:var(--sans),'Microsoft YaHei',sans-serif;font-size:22px;font-weight:650;line-height:1.55;min-height:42px;margin:0 0 20px;white-space:pre-wrap}
  #weeklyReports .paper-metadata{display:flex;justify-content:flex-end;align-items:center;gap:14px;flex-wrap:wrap;min-height:38px;margin-bottom:28px}
  #weeklyReports .paper-author{max-width:180px;width:40%;text-align:right}
  #weeklyReports .paper-date{max-width:176px;width:50%}
  #weeklyReports .paper-field-label{font:12px/1.4 var(--sans);color:var(--dim);display:block;margin-bottom:5px}
  #weeklyReports .paper-metadata label{max-width:48%}
  #weeklyReports .paper-metadata label input{width:100%;max-width:180px}
  #weeklyReports .paper-input,#weeklyReports .block-textarea{color:var(--text);background:transparent;border:1px solid var(--line);border-radius:4px;padding:9px 11px;line-height:1.8;resize:vertical;min-width:0;max-width:100%}
  #weeklyReports .paper-input::placeholder,#weeklyReports .block-textarea::placeholder{color:var(--dim);opacity:.7;font-weight:400}
  #weeklyReports .paper-input:focus,#weeklyReports .block-textarea:focus{outline:2px solid var(--primary-soft);border-color:var(--primary)}
  #weeklyReports .paper-title-input{width:100%;text-align:center;font-family:var(--sans);font-size:22px;font-weight:600;min-height:58px;margin-bottom:20px}
  #weeklyReports .report-section{min-width:0}
  #weeklyReports .report-section-body{min-height:56px}
  #weeklyReports .report-section-body p{margin:0 0 12px;white-space:pre-wrap;overflow-wrap:anywhere}
  #weeklyReports .report-section-body ol{padding-left:1.8em;margin:0 0 16px}
  #weeklyReports .report-section-body li{padding-left:.3em;white-space:pre-wrap;overflow-wrap:anywhere}
  #weeklyReports .report-section-body a{overflow-wrap:anywhere;text-underline-offset:3px}
  #weeklyReports .report-block{position:relative;margin:0 0 16px;min-width:0}
  #weeklyReports .block-textarea{display:block;width:100%;font-family:inherit;font-size:18px;min-height:88px}
  #weeklyReports .list-textarea{min-height:112px}
  #weeklyReports .block-bar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:6px;font-family:var(--sans);font-size:11px;color:var(--dim)}
  #weeklyReports .block-tools{display:flex;align-items:center;gap:1px}
  #weeklyReports .block-tools button{border:0;background:transparent;color:var(--dim);border-radius:4px;min-width:30px;min-height:30px;padding:3px 7px;font-family:var(--sans);font-size:12px}
  #weeklyReports .block-tools button:hover{background:var(--surface-2);color:var(--text)}
  #weeklyReports .block-add{display:flex;flex-wrap:wrap;gap:6px;margin:5px 0 24px}
  #weeklyReports .block-add button{background:transparent;border:1px dashed var(--line-strong);border-radius:4px;color:var(--muted);font:12px/1.4 var(--sans);padding:7px 10px;min-height:34px}
  #weeklyReports .block-add button:hover{background:var(--surface-2);border-color:var(--dim)}
  #weeklyReports .report-figure{margin:8px 0 20px}
  #weeklyReports .report-figure img{display:block;width:auto;max-width:100%;height:auto;max-height:720px;margin-inline:auto;object-fit:contain}
  #weeklyReports .report-figure figcaption{font-size:15px;color:var(--muted);text-align:center;margin-top:10px;white-space:pre-wrap}
  #weeklyReports .image-editor-meta{display:grid;gap:9px;margin-top:12px;font-family:var(--sans)}
  #weeklyReports .image-editor-meta label{font-size:12px;color:var(--dim)}
  #weeklyReports .image-editor-meta input{display:block;width:100%;font-size:15px;margin-top:4px}
  #weeklyReports .image-failure{font:13px/1.6 var(--sans);color:var(--orange);text-align:center}
  #weeklyReports .report-export{display:flex;justify-content:flex-end;align-items:center;gap:14px;padding:20px 0 4px}
  #weeklyReports .report-export>span{font:11px/1.5 var(--mono);color:var(--dim)}
  @media(max-width:1060px){#weeklyReports .weekly-layout{grid-template-columns:170px minmax(0,1fr);gap:22px}#weeklyReports .weekly-index{padding-right:16px}#weeklyReports .report-paper{padding:32px 25px}}
  @media(max-width:760px){#weeklyReports .weekly-layout{grid-template-columns:minmax(0,1fr);gap:20px;padding-top:18px}#weeklyReports .weekly-index{border:0;border-bottom:1px solid var(--line);padding:0 0 16px}#weeklyReports .weekly-index-heading{padding-bottom:10px}#weeklyReports #reportList{display:flex;gap:8px;overflow-x:auto;padding-bottom:5px}#weeklyReports .report-index-item{width:160px;flex:0 0 160px;border:1px solid var(--line);border-radius:6px;padding:10px 12px}#weeklyReports .report-index-item[aria-current="page"]{border-color:var(--primary)}#weeklyReports .report-toolbar{gap:12px}#weeklyReports .report-actions{width:100%}#weeklyReports .report-paper{padding:26px 20px;min-height:620px}#weeklyReports .page-heading{gap:14px}#weeklyReports .page-heading h1{font-size:32px}#weeklyReports #newReport{font-size:12px;white-space:nowrap}#weeklyReports .paper-title-input,#weeklyReports .report-paper .paper-title{font-size:20px}#weeklyReports .report-paper,#weeklyReports .block-textarea{font-size:17px}#weeklyReports .report-paper h2{font-size:18px}#weeklyReports .paper-metadata{gap:10px}}
  @media(max-width:420px){#weeklyReports .page-heading{align-items:flex-start;flex-direction:column}#weeklyReports .report-paper{padding:24px 15px}#weeklyReports .report-actions button{padding-inline:9px}#weeklyReports .report-identity h2{font-size:20px}#weeklyReports .paper-metadata label{max-width:100%}#weeklyReports .paper-metadata input{font-size:16px}}
</style>

---
import type { CollectionEntry } from "astro:content";
import { noteBlocks, paperCategory } from "../lib/library";

interface Props { paper: CollectionEntry<"papers">; }
const { paper } = Astro.props;
const data = paper.data;
const category = paperCategory(data.category);
const blocks = noteBlocks(paper.body);
const referencedFigures = new Set([...data.materials, ...data.methods, ...data.innovations, ...data.results].flatMap((item) => item.figureIds));
const remainingFigures = data.figures.filter((figure) => !referencedFigures.has(figure.id));
const linkedFigures = (ids: string[]) => data.figures.filter((figure) => ids.includes(figure.id));
const initialSections = [
  { id: "materials", kicker: "MATERIALS / RESEARCH SUBJECT", title: "原材料与研究对象", items: data.materials },
  { id: "methods", kicker: "RESEARCH METHODS", title: "研究方法", items: data.methods },
].filter((section) => section.items.length);
const sections = [
  { id: "problem", label: "研究问题", visible: Boolean(data.problem) },
  { id: "team", label: "期刊与团队", visible: true },
  ...initialSections.map((section) => ({ id: section.id, label: section.title, visible: true })),
  { id: "innovations", label: "创新点", visible: data.innovations.length > 0 },
  { id: "results", label: "结果与结论", visible: data.results.length > 0 || data.conclusions.length > 0 },
  { id: "figures", label: "论文图示", visible: remainingFigures.length > 0 },
  { id: "notes", label: "学习解读", visible: blocks.length > 0 },
  { id: "references", label: "来源与引用", visible: data.references.length > 0 },
].filter((section) => section.visible);
---

<article class="paper-report">
  <nav class="breadcrumbs" aria-label="当前位置"><a href="/photoacoustic/">光声成像</a><span aria-hidden="true">/</span><a href={`/photoacoustic/${category.groupSlug}/`}>{category.groupTitle}</a><span aria-hidden="true">/</span><a href={`/photoacoustic/${category.path}/`}>{category.title}</a><span aria-hidden="true">/</span><span aria-current="page">文献解读</span></nav>
  <header class="report-header">
    <p class="eyebrow">PAPER REPORT / {category.title}</p>
    <p class="journal-meta">{data.journal}<span aria-hidden="true">·</span>{data.year}</p>
    <h1>{data.title}</h1>
    <p class="authors">{data.authors.join(" · ")}</p>
    <p class="report-summary">{data.summary}</p>
    <div class="paper-details">{data.doi && <a href={`https://doi.org/${encodeURIComponent(data.doi).replace(/%2F/g, "/")}`} target="_blank" rel="noopener noreferrer">DOI: {data.doi} <span aria-hidden="true">↗</span></a>}{data.updated && <span>更新于 {data.updated}</span>}</div>
    {data.tags.length > 0 && <div class="report-tags">{data.tags.map((tag) => <span>{tag}</span>)}</div>}
    <div class="download-links" aria-label="原始资料下载">
      {data.downloads.pdf ? <a class="filled-btn" href={data.downloads.pdf.url} download={data.downloads.pdf.url.startsWith("/") ? data.downloads.pdf.label : undefined} target={data.downloads.pdf.url.startsWith("/") ? undefined : "_blank"} rel="noopener noreferrer"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 2v10m-4-4 4 4 4-4M3 12v5h14v-5"/></svg>原版 PDF{data.downloads.pdf.size && <small>{data.downloads.pdf.size}</small>}</a> : <span class="missing-file">原版 PDF 尚未提供</span>}
      {data.downloads.notes ? <a class="subtle-btn" href={data.downloads.notes.url} download={data.downloads.notes.url.startsWith("/") ? data.downloads.notes.label : undefined} target={data.downloads.notes.url.startsWith("/") ? undefined : "_blank"} rel="noopener noreferrer">下载学习笔记 <span aria-hidden="true">↓</span>{data.downloads.notes.size && <small>{data.downloads.notes.size}</small>}</a> : <span class="missing-file">学习笔记尚未提供</span>}
    </div>
  </header>

  <div class="report-layout">
    <aside class="reading-nav"><p>ON THIS PAGE</p><nav aria-label="本文目录">{sections.map((section, index) => <a href={`#${section.id}`}><span>{String(index + 1).padStart(2, "0")}</span>{section.label}</a>)}</nav><a class="back-category" href={`/photoacoustic/${category.path}/`}>← 返回 {category.title}</a></aside>
    <div class="report-body">
      {data.problem && <section id="problem" class="report-section"><p class="section-kicker">THE RESEARCH PROBLEM</p><h2>研究问题</h2><p class="section-text">{data.problem}</p></section>}

      <section id="team" class="report-section">
        <p class="section-kicker">JOURNAL / RESEARCH TEAM</p><h2>期刊与研究团队</h2>
        <dl class="publication-info"><div><dt>期刊</dt><dd>{data.journal}</dd></div><div><dt>发表年份</dt><dd>{data.year}</dd></div><div><dt>作者</dt><dd>{data.authors.join(" · ")}</dd></div></dl>
        {data.team ? <div class="team-description"><h3>{data.team.name}</h3>{data.team.institution && <p class="institution">{data.team.institution}</p>}<p class="small-label">团队主要研究工作</p>{data.team.mainWork.map((text) => <p class="section-text">{text}</p>)}<div class="source-links">{data.team.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a>)}</div></div> : <p class="pending-detail">团队研究方向尚未核实。</p>}
      </section>

      {initialSections.map((section) => <section id={section.id} class="report-section"><p class="section-kicker">{section.kicker}</p><h2>{section.title}</h2>{section.items.map((item) => <div class="explanation-block"><h3>{item.title}</h3><p class="section-text">{item.text}</p>{linkedFigures(item.figureIds).map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`查看大图：${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">原文来源 ↗</a></>}</span></figcaption></figure>)}</div>)}</section>)}

      {data.innovations.length > 0 && <section id="innovations" class="report-section"><p class="section-kicker">WHAT CHANGED / WHY IT WORKS</p><h2>创新点</h2>{data.innovations.map((innovation, index) => <div class="innovation-block"><div class="innovation-title"><span>{String(index + 1).padStart(2, "0")}</span><h3>{innovation.title}</h3></div><div class="innovation-flow"><div><p class="small-label">原有困难</p><p>{innovation.before}</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><p class="small-label">研究中的改变</p><p>{innovation.change}</p></div></div><p class="small-label">为什么这一步有效</p><p class="section-text">{innovation.why}</p>{linkedFigures(innovation.figureIds).map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`查看大图：${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">原文来源 ↗</a></>}</span></figcaption></figure>)}<div class="evidence-row"><p class="small-label">文献证据</p><p class="section-text">{innovation.evidence}</p></div><div class="tradeoff-row"><p class="small-label">代价与适用边界</p><p class="section-text">{innovation.tradeoff}</p></div></div>)}</section>}

      {(data.results.length > 0 || data.conclusions.length > 0) && <section id="results" class="report-section"><p class="section-kicker">RESULTS / CONCLUSIONS</p><h2>结果与结论</h2>{data.results.map((result) => <div class="explanation-block"><h3>{result.title}</h3><p class="section-text">{result.text}</p>{linkedFigures(result.figureIds).map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`查看大图：${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">原文来源 ↗</a></>}</span></figcaption></figure>)}</div>)}{data.conclusions.length > 0 && <div class="conclusions"><p class="small-label">这篇文献留下的结论</p>{data.conclusions.map((conclusion) => <p class="section-text">{conclusion}</p>)}</div>}</section>}

      {remainingFigures.length > 0 && <section id="figures" class="report-section"><p class="section-kicker">FIGURES FROM THE PAPER</p><h2>论文图示</h2>{remainingFigures.map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`查看大图：${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">原文来源 ↗</a></>}</span></figcaption></figure>)}</section>}

      {blocks.length > 0 && <section id="notes" class="report-section reading-notes"><p class="section-kicker">READING NOTES</p><h2>学习解读</h2>{blocks.map((block) => block.type === "heading" ? <h3>{block.text}</h3> : block.type === "paragraph" ? <p class="section-text">{block.text}</p> : block.type === "quote" ? <blockquote>{block.text}</blockquote> : block.ordered ? <ol>{block.items.map((item) => <li>{item}</li>)}</ol> : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>)}</section>}

      {data.references.length > 0 && <section id="references" class="report-section"><p class="section-kicker">SOURCES / REFERENCES</p><h2>来源与引用</h2><ol class="reference-list">{data.references.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span aria-hidden="true"> ↗</span></a></li>)}</ol></section>}
      <div class="report-end"><span>RAY_LEE / RESEARCH JOURNAL</span><a href={`/photoacoustic/${category.path}/`}>回到分类目录 <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
</article>

<style>
  a{color:inherit;text-decoration:none}.report-header{display:block;align-items:normal;justify-content:normal;padding:0;border:0}
  .paper-report{max-width:1150px;margin:0 auto;padding:30px 36px 75px}.breadcrumbs{display:flex;gap:9px;align-items:center;flex-wrap:wrap;color:var(--dim);font-size:14px;line-height:1.8;margin-bottom:35px}.breadcrumbs a:hover{color:var(--primary)}.report-header{max-width:880px;margin:0 0 45px}.report-header .eyebrow{font-size:14px;letter-spacing:.14em;color:var(--teal);margin:0 0 22px}.journal-meta{color:var(--muted);font:14px "JetBrains Mono",monospace;margin:0 0 15px}.journal-meta span{color:var(--dim);margin:0 12px}.report-header h1{font-size:clamp(27px,4vw,41px);font-weight:500;line-height:1.35;letter-spacing:-.045em;margin:0 0 19px;overflow-wrap:anywhere}.authors{font-size:14px;color:var(--dim);line-height:1.8;margin:0 0 22px}.report-summary{font-size:14px;line-height:1.9;color:var(--muted);margin:0 0 21px;white-space:pre-line}.paper-details{display:flex;gap:22px;flex-wrap:wrap;font-size:14px;color:var(--dim);overflow-wrap:anywhere}.paper-details>a{color:var(--teal)}.report-tags{display:flex;gap:6px;flex-wrap:wrap;margin:18px 0 0}.report-tags>span{font-size:14px;border:1px solid var(--line);border-radius:5px;padding:5px 8px;color:var(--muted)}.download-links{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:26px}.download-links>a{display:inline-flex;align-items:center;gap:9px;font-size:14px;padding:12px 16px}.download-links small{font-size:14px;opacity:.6;margin-left:5px}.missing-file{font-size:14px;color:var(--dim);padding:10px 0}.report-layout{display:grid;grid-template-columns:175px minmax(0,1fr);gap:50px;align-items:start}.reading-nav{position:sticky;top:100px}.reading-nav>p{font:14px "JetBrains Mono",monospace;letter-spacing:.15em;color:var(--dim);margin:5px 0 18px}.reading-nav nav{display:grid;gap:6px}.reading-nav nav a{display:flex;gap:11px;align-items:baseline;font-size:14px;color:var(--muted);padding:8px 0;line-height:1.6}.reading-nav nav a>span{font:14px "JetBrains Mono",monospace;color:var(--dim)}.reading-nav a:hover{color:var(--primary)}.back-category{display:block;font-size:14px;color:var(--dim);margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}.report-body{min-width:0}.report-section{padding:31px 0;border-top:1px solid var(--line);scroll-margin-top:100px}.section-kicker{font:14px "JetBrains Mono",monospace;letter-spacing:.15em;color:var(--teal);margin:0 0 13px}.report-section h2{font-size:24px;font-weight:500;letter-spacing:-.035em;margin:0 0 24px}.report-section h3{font-size:17px;font-weight:500;line-height:1.6;margin:0 0 12px}.section-text{font-size:14px;line-height:2;color:var(--muted);white-space:pre-line;margin:0 0 15px}.publication-info{margin:0 0 26px;display:grid;gap:12px}.publication-info>div{display:grid;grid-template-columns:75px minmax(0,1fr);font-size:14px;line-height:1.8}.publication-info dt{color:var(--dim)}.publication-info dd{margin:0;color:var(--text)}.institution{font-size:14px;color:var(--dim);margin:0 0 22px}.small-label{font-size:14px;line-height:1.8;letter-spacing:.025em;color:var(--teal);margin:0 0 9px}.source-links{display:flex;gap:15px;flex-wrap:wrap;margin-top:16px}.source-links a{font-size:14px;color:var(--primary)}.pending-detail{font-size:14px;color:var(--dim)}.explanation-block+.explanation-block{margin-top:29px}.paper-figure{margin:27px 0 24px}.paper-figure>a{display:block}.paper-figure img{display:block;width:100%;max-height:600px;object-fit:contain;border-radius:3px}.paper-figure figcaption{display:grid;gap:6px;line-height:1.8;margin-top:13px}.paper-figure figcaption strong{font-size:14px;font-weight:400;color:var(--muted)}.paper-figure figcaption>span{font-size:14px;color:var(--dim)}.paper-figure figcaption a{color:var(--teal)}.innovation-block+.innovation-block{margin-top:34px;padding-top:30px;border-top:1px solid var(--line)}.innovation-title{display:flex;gap:13px;align-items:baseline;margin-bottom:23px}.innovation-title>span{font:18px "JetBrains Mono",monospace;color:var(--teal)}.innovation-title h3{font-size:19px;margin:0}.innovation-flow{display:grid;grid-template-columns:minmax(0,1fr) 25px minmax(0,1fr);gap:18px;margin-bottom:27px;align-items:center}.innovation-flow>div{border-left:2px solid var(--line);padding:0 0 0 15px}.innovation-flow>div:last-child{border-color:var(--teal)}.innovation-flow>div>p:last-child{font-size:14px;line-height:1.9;color:var(--muted);margin:0;white-space:pre-line}.flow-arrow{font-size:23px;color:var(--teal)}.evidence-row,.tradeoff-row{padding-top:16px}.tradeoff-row .small-label{color:var(--orange)}.conclusions{padding:22px 0 0;margin-top:10px;border-top:1px solid var(--line)}.reading-notes ul,.reading-notes ol{padding-left:23px;font-size:14px;line-height:2;color:var(--muted);margin:0 0 20px}.reading-notes li+li{margin-top:7px}.reading-notes blockquote{border-left:2px solid var(--teal);padding-left:18px;margin:20px 0;font-size:14px;line-height:2;color:var(--muted);white-space:pre-line}.reference-list{padding-left:20px;font-size:14px;line-height:1.9;color:var(--muted);margin:0}.reference-list li{padding-left:6px;margin-bottom:12px}.reference-list a:hover{color:var(--primary)}.report-end{border-top:1px solid var(--line);padding-top:25px;display:flex;gap:20px;justify-content:space-between;align-items:center}.report-end>span{font:14px "JetBrains Mono",monospace;letter-spacing:.12em;color:var(--dim)}.report-end>a{font-size:14px;color:var(--teal)}
  @media(max-width:850px){.report-layout{grid-template-columns:145px minmax(0,1fr);gap:28px}.report-header h1{font-size:33px}.innovation-flow{gap:11px}}
  @media(max-width:650px){.paper-report{padding:25px 20px 50px}.breadcrumbs{font-size:14px;margin-bottom:25px}.report-header h1{font-size:28px}.report-summary{font-size:14px}.report-layout{grid-template-columns:1fr;gap:20px}.reading-nav{position:static;border-top:1px solid var(--line);padding-top:20px}.reading-nav nav{display:flex;flex-wrap:wrap;gap:8px 17px}.reading-nav nav a{font-size:14px;padding:4px 0}.reading-nav>p{margin-bottom:10px}.back-category{display:none}.report-header{margin-bottom:28px}.report-section{padding:27px 0}.report-section h2{font-size:22px}.section-text{font-size:14px}.innovation-flow{grid-template-columns:1fr;gap:13px}.flow-arrow{transform:rotate(90deg);width:20px;justify-self:center}.innovation-flow>div{padding-left:12px}.download-links>a{font-size:14px;padding:11px 13px}.paper-figure{margin:20px 0}.report-end{flex-wrap:wrap}}

  .report-summary,.section-text,.innovation-flow>div>p:last-child,.reading-notes ul,.reading-notes ol,.reading-notes blockquote,.reference-list{font-size:16px;line-height:1.9}
  .publication-info>div{font-size:16px}
  .download-links>a{font-size:16px;line-height:1.6}
  .paper-report,.reading-nav,.explanation-block,.innovation-block{overflow-wrap:anywhere}
  .paper-figure figcaption strong{font-size:15px;line-height:1.8}
  .paper-figure figcaption>span,.small-label{font-size:14px;line-height:1.8}
  .reading-nav nav a{font-size:14px;line-height:1.7}
  .reading-nav>p,.section-kicker,.report-end>span{line-height:1.7;letter-spacing:.08em}
  .download-links>a{max-width:100%;flex-wrap:wrap}
  .publication-info dd{min-width:0}
  @media(max-width:850px){.report-layout{grid-template-columns:160px minmax(0,1fr);gap:28px}}
  @media(max-width:650px){
    .report-layout{grid-template-columns:minmax(0,1fr)}
    .report-summary,.section-text,.innovation-flow>div>p:last-child,.reading-notes ul,.reading-notes ol,.reading-notes blockquote,.reference-list{font-size:16px}
    .reading-nav nav a{font-size:14px;padding:7px 0}
    .reading-nav nav{gap:6px 18px}
    .download-links>a{font-size:16px;padding:12px 14px}
    .breadcrumbs{font-size:14px;gap:7px}
    .report-end{align-items:flex-start;gap:14px}
  }
</style>

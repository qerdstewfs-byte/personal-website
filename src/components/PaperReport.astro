---
import type { CollectionEntry } from "astro:content";
import { noteBlocks, paperCategory } from "../lib/library";

interface Props { paper: CollectionEntry<"papers">; }
const { paper } = Astro.props;
const data = paper.data;
const category = paperCategory(data.category);
const blocks = noteBlocks(paper.body);
const referencedFigures = new Set([...data.materials, ...data.methods, ...data.innovations, ...data.results].flatMap((item) => item.figureIds));
const remainingFigures = data.figures.filter((figure) => !referencedFigures.has(figure.id));
const linkedFigures = (ids: string[]) => data.figures.filter((figure) => ids.includes(figure.id));
const initialSections = [
  { id: "materials", kicker: "MATERIALS / RESEARCH SUBJECT", title: "Materials", items: data.materials },
  { id: "methods", kicker: "RESEARCH METHODS", title: "Methods", items: data.methods },
].filter((section) => section.items.length);
const sections = [
  { id: "problem", label: "Research problem", visible: Boolean(data.problem) },
  { id: "team", label: "Publication & team", visible: true },
  ...initialSections.map((section) => ({ id: section.id, label: section.title, visible: true })),
  { id: "innovations", label: "Innovations", visible: data.innovations.length > 0 },
  { id: "results", label: "Results & conclusions", visible: data.results.length > 0 || data.conclusions.length > 0 },
  { id: "figures", label: "Figures", visible: remainingFigures.length > 0 },
  { id: "notes", label: "Reading notes", visible: blocks.length > 0 },
  { id: "references", label: "References", visible: data.references.length > 0 },
].filter((section) => section.visible);
---

<article class="paper-report">
  <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/photoacoustic/">Photoacoustic Imaging</a><span aria-hidden="true">/</span><a href={`/photoacoustic/${category.groupSlug}/`}>{category.groupTitle}</a><span aria-hidden="true">/</span><a href={`/photoacoustic/${category.path}/`}>{category.title}</a><span aria-hidden="true">/</span><span aria-current="page">Paper report</span></nav>
  <header class="report-header">
    <p class="eyebrow">PAPER REPORT / {category.title}</p>
    <p class="journal-meta">{data.journal}<span aria-hidden="true">·</span>{data.year}</p>
    <h1>{data.title}</h1>
    <p class="authors">{data.authors.join(" · ")}</p>
    <p class="report-summary">{data.summary}</p>
    <div class="paper-details">{data.doi && <a href={`https://doi.org/${encodeURIComponent(data.doi).replace(/%2F/g, "/")}`} target="_blank" rel="noopener noreferrer">DOI: {data.doi} <span aria-hidden="true">↗</span></a>}{data.updated && <span>Updated {data.updated}</span>}</div>
    {data.tags.length > 0 && <div class="report-tags">{data.tags.map((tag) => <span>{tag}</span>)}</div>}
    <div class="download-links" aria-label="Downloads">
      {data.downloads.pdf ? <a class="filled-btn" href={data.downloads.pdf.url} download={data.downloads.pdf.url.startsWith("/") ? data.downloads.pdf.label : undefined} target={data.downloads.pdf.url.startsWith("/") ? undefined : "_blank"} rel="noopener noreferrer"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 2v10m-4-4 4 4 4-4M3 12v5h14v-5"/></svg>Original PDF{data.downloads.pdf.size && <small>{data.downloads.pdf.size}</small>}</a> : <span class="missing-file">PDF unavailable</span>}
      {data.downloads.notes ? <a class="subtle-btn" href={data.downloads.notes.url} download={data.downloads.notes.url.startsWith("/") ? data.downloads.notes.label : undefined} target={data.downloads.notes.url.startsWith("/") ? undefined : "_blank"} rel="noopener noreferrer">Reading notes <span aria-hidden="true">↓</span>{data.downloads.notes.size && <small>{data.downloads.notes.size}</small>}</a> : <span class="missing-file">Notes unavailable</span>}
    </div>
  </header>

  <div class="report-layout">
    <aside class="reading-nav"><p>ON THIS PAGE</p><nav aria-label="On this page">{sections.map((section, index) => <a href={`#${section.id}`}><span>{String(index + 1).padStart(2, "0")}</span>{section.label}</a>)}</nav><a class="back-category" href={`/photoacoustic/${category.path}/`}>← Back to {category.title}</a></aside>
    <div class="report-body">
      {data.problem && <section id="problem" class="report-section"><h2>Research problem</h2><p class="section-text">{data.problem}</p></section>}

      <section id="team" class="report-section">
        <h2>Publication & research team</h2>
        <dl class="publication-info"><div><dt>Journal</dt><dd>{data.journal}</dd></div><div><dt>Year</dt><dd>{data.year}</dd></div><div><dt>Authors</dt><dd>{data.authors.join(" · ")}</dd></div></dl>
        {data.team ? <div class="team-description"><h3>{data.team.name}</h3>{data.team.institution && <p class="institution">{data.team.institution}</p>}<p class="small-label">Research focus</p>{data.team.mainWork.map((text) => <p class="section-text">{text}</p>)}<div class="source-links">{data.team.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a>)}</div></div> : <p class="pending-detail">Team details unverified.</p>}
      </section>

      {initialSections.map((section) => <section id={section.id} class="report-section"><h2>{section.title}</h2>{section.items.map((item) => <div class="explanation-block"><h3>{item.title}</h3><p class="section-text">{item.text}</p>{linkedFigures(item.figureIds).map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`View full-size figure: ${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">Source ↗</a></>}</span></figcaption></figure>)}</div>)}</section>)}

      {data.innovations.length > 0 && <section id="innovations" class="report-section"><h2>Innovations</h2>{data.innovations.map((innovation, index) => <div class="innovation-block"><div class="innovation-title"><span>{String(index + 1).padStart(2, "0")}</span><h3>{innovation.title}</h3></div><div class="innovation-flow"><div><p class="small-label">Limitation</p><p>{innovation.before}</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><p class="small-label">Approach</p><p>{innovation.change}</p></div></div><p class="small-label">How it works</p><p class="section-text">{innovation.why}</p>{linkedFigures(innovation.figureIds).map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`View full-size figure: ${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">Source ↗</a></>}</span></figcaption></figure>)}<div class="evidence-row"><p class="small-label">Evidence</p><p class="section-text">{innovation.evidence}</p></div><div class="tradeoff-row"><p class="small-label">Trade-offs & limitations</p><p class="section-text">{innovation.tradeoff}</p></div></div>)}</section>}

      {(data.results.length > 0 || data.conclusions.length > 0) && <section id="results" class="report-section"><h2>Results & conclusions</h2>{data.results.map((result) => <div class="explanation-block"><h3>{result.title}</h3><p class="section-text">{result.text}</p>{linkedFigures(result.figureIds).map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`View full-size figure: ${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">Source ↗</a></>}</span></figcaption></figure>)}</div>)}{data.conclusions.length > 0 && <div class="conclusions"><p class="small-label">Conclusions</p>{data.conclusions.map((conclusion) => <p class="section-text">{conclusion}</p>)}</div>}</section>}

      {remainingFigures.length > 0 && <section id="figures" class="report-section"><h2>Figures</h2>{remainingFigures.map((figure) => <figure class="paper-figure"><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`View full-size figure: ${figure.alt}`}><img src={figure.src} alt={figure.alt} loading="lazy" /></a><figcaption><strong>{figure.caption}</strong><span>{figure.attribution}{figure.source && <> · <a href={figure.source} target="_blank" rel="noopener noreferrer">Source ↗</a></>}</span></figcaption></figure>)}</section>}

      {blocks.length > 0 && <section id="notes" class="report-section reading-notes"><h2>Reading notes</h2>{blocks.map((block) => block.type === "heading" ? <h3>{block.text}</h3> : block.type === "paragraph" ? <p class="section-text">{block.text}</p> : block.type === "quote" ? <blockquote>{block.text}</blockquote> : block.ordered ? <ol>{block.items.map((item) => <li>{item}</li>)}</ol> : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>)}</section>}

      {data.references.length > 0 && <section id="references" class="report-section"><h2>References</h2><ol class="reference-list">{data.references.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}<span aria-hidden="true"> ↗</span></a></li>)}</ol></section>}
      <div class="report-end"><a href={`/photoacoustic/${category.path}/`}>Back to category <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
</article>

<style>
  .download-links>a.filled-btn{color:var(--button-text)}
  a{color:inherit;text-decoration:none}.paper-report{max-width:1200px;margin:0 auto;padding:28px 0 64px;overflow-wrap:anywhere}.breadcrumbs{display:flex;align-items:center;flex-wrap:wrap;gap:9px;font-size:14px;line-height:1.7;color:var(--dim);margin-bottom:24px}.breadcrumbs a:hover{color:var(--primary)}
  .report-header{display:block;align-items:normal;justify-content:normal;max-width:960px;margin:0 0 36px;padding:0;border:0}.report-header .eyebrow{font-size:14px;font-weight:600;line-height:1.7;letter-spacing:.06em;color:var(--teal);margin:0 0 12px}.journal-meta{font-size:15px;line-height:1.7;color:var(--muted);margin:0 0 10px}.journal-meta span{color:var(--dim);margin:0 10px}.report-header h1{font-size:clamp(30px,3.5vw,38px);font-weight:650;line-height:1.4;letter-spacing:-.03em;margin:0 0 15px}.authors{font-size:15px;line-height:1.8;color:var(--dim);margin:0 0 18px}.report-summary{font-size:18px;line-height:1.85;color:var(--muted);white-space:pre-line;margin:0 0 18px;max-width:840px}.paper-details{display:flex;flex-wrap:wrap;gap:9px 24px;font-size:14px;line-height:1.8;color:var(--dim)}.paper-details>a{color:var(--teal)}.report-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:16px}.report-tags>span{font-size:14px;line-height:1.6;padding:3px 8px;border-radius:4px;background:var(--surface-2);color:var(--muted)}
  .download-links{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:22px}.download-links>a{display:inline-flex;align-items:center;flex-wrap:wrap;gap:9px;font-size:16px;line-height:1.5;padding:12px 17px;max-width:100%;border-radius:6px}.download-links small{font-size:14px;opacity:.8}.missing-file{font-size:14px;line-height:1.7;color:var(--dim);padding:8px 0}
  .report-layout{display:grid;grid-template-columns:186px minmax(0,1fr);gap:42px;align-items:start}.reading-nav{position:sticky;top:24px;min-width:0;padding-right:20px}.reading-nav>p{font-size:14px;line-height:1.7;font-weight:600;letter-spacing:.06em;color:var(--dim);margin:1px 0 14px}.reading-nav nav{display:grid;gap:4px}.reading-nav nav a{display:flex;align-items:baseline;gap:10px;font-size:15px;line-height:1.7;color:var(--muted);padding:7px 0}.reading-nav nav a>span{flex:0 0 20px;white-space:nowrap;font-size:14px;font-variant-numeric:tabular-nums;color:var(--dim)}.reading-nav a:hover{color:var(--primary)}.back-category{display:block;font-size:14px;line-height:1.7;color:var(--dim);margin-top:20px;padding-top:17px;border-top:1px solid var(--line)}.report-body{min-width:0;max-width:860px}
  .report-section{padding:28px 0;border-top:1px solid var(--line);scroll-margin-top:24px}.section-kicker{font-size:14px;font-weight:600;line-height:1.7;letter-spacing:.06em;color:var(--teal);margin:0 0 6px}.report-section h2{font-size:26px;font-weight:650;line-height:1.5;letter-spacing:-.025em;margin:0 0 21px}.report-section h3{font-size:21px;font-weight:600;line-height:1.6;margin:0 0 12px}.section-text{font-size:18px;line-height:1.9;color:var(--muted);white-space:pre-line;margin:0 0 16px}.publication-info{margin:0 0 26px;display:grid;gap:12px}.publication-info>div{display:grid;grid-template-columns:85px minmax(0,1fr);gap:12px;font-size:17px;line-height:1.8}.publication-info dt{color:var(--dim)}.publication-info dd{min-width:0;margin:0;color:var(--text)}.institution{font-size:16px;line-height:1.8;color:var(--dim);margin:0 0 20px}.small-label{font-size:15px;font-weight:600;line-height:1.8;color:var(--teal);margin:0 0 8px}.source-links{display:flex;gap:12px 20px;flex-wrap:wrap;margin-top:16px}.source-links a{font-size:14px;line-height:1.8;color:var(--primary)}.source-links a:hover{text-decoration:underline}.pending-detail{font-size:17px;line-height:1.8;color:var(--dim)}.explanation-block+.explanation-block{margin-top:30px}
  .paper-figure{margin:27px 0}.paper-figure>a{display:block}.paper-figure img{display:block;width:100%;height:auto;max-height:700px;object-fit:contain}.paper-figure figcaption{display:grid;gap:6px;line-height:1.8;margin-top:13px}.paper-figure figcaption strong{font-size:16px;font-weight:400;color:var(--muted)}.paper-figure figcaption>span{font-size:14px;color:var(--dim)}.paper-figure figcaption a{color:var(--teal)}
  .innovation-block+.innovation-block{margin-top:32px;padding-top:30px;border-top:1px solid var(--line)}.innovation-title{display:flex;align-items:baseline;gap:13px;margin-bottom:22px}.innovation-title>span{font-size:18px;font-variant-numeric:tabular-nums;color:var(--teal)}.innovation-title h3{font-size:22px;margin:0}.innovation-flow{display:grid;grid-template-columns:minmax(0,1fr) 24px minmax(0,1fr);gap:18px;align-items:center;margin-bottom:24px}.innovation-flow>div{border-left:3px solid var(--line);padding-left:16px}.innovation-flow>div:last-child{border-color:var(--teal)}.innovation-flow>div>p:last-child{font-size:17px;line-height:1.9;color:var(--muted);white-space:pre-line;margin:0}.flow-arrow{font-size:24px;color:var(--teal)}.evidence-row,.tradeoff-row{padding-top:13px}.tradeoff-row .small-label{color:var(--orange)}.conclusions{padding-top:22px;margin-top:12px;border-top:1px solid var(--line)}
  .reading-notes ul,.reading-notes ol{padding-left:24px;font-size:18px;line-height:1.9;color:var(--muted);margin:0 0 20px}.reading-notes li+li{margin-top:8px}.reading-notes blockquote{border-left:3px solid var(--teal);padding-left:18px;margin:20px 0;font-size:18px;line-height:1.9;color:var(--muted);white-space:pre-line}.reference-list{padding-left:22px;font-size:17px;line-height:1.9;color:var(--muted);margin:0}.reference-list li{padding-left:4px;margin-bottom:12px}.reference-list a:hover{color:var(--primary);text-decoration:underline}.report-end{border-top:1px solid var(--line);padding-top:24px;display:flex;flex-wrap:wrap;gap:14px 24px;justify-content:space-between;align-items:baseline}.report-end>span{font-size:14px;line-height:1.7;color:var(--dim)}.report-end>a{font-size:15px;line-height:1.7;color:var(--teal)}
  @media(max-width:900px){.report-layout{grid-template-columns:166px minmax(0,1fr);gap:25px}.reading-nav{padding-right:8px}.innovation-flow{grid-template-columns:minmax(0,1fr);gap:13px}.flow-arrow{transform:rotate(90deg);justify-self:center;width:24px}}
  @media(max-width:700px){.paper-report{padding:24px 0 48px}.report-header{margin-bottom:26px}.report-header h1{font-size:30px}.report-summary,.section-text,.reading-notes ul,.reading-notes ol,.reading-notes blockquote{font-size:17px}.report-layout{grid-template-columns:minmax(0,1fr);gap:22px}.reading-nav{position:static;padding:16px 0 0;border-top:1px solid var(--line)}.reading-nav>p{margin-bottom:9px}.reading-nav nav{display:flex;flex-wrap:wrap;gap:4px 20px}.reading-nav nav a{font-size:14px;gap:7px;padding:5px 0}.back-category{display:none}.report-section{padding:25px 0}.report-section h2{font-size:24px}.report-section h3,.innovation-title h3{font-size:20px}.breadcrumbs{gap:7px;margin-bottom:21px}.publication-info>div{grid-template-columns:68px minmax(0,1fr);gap:10px}.download-links>a{padding:11px 14px}.paper-figure{margin:23px 0}}
  @media(max-width:380px){.paper-report{padding-left:0;padding-right:0}}
</style>

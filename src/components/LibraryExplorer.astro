  @media(max-width:760px){
    .folder-panel nav{grid-template-columns:minmax(0,1fr);gap:18px}
    .folder-panel{padding:20px 16px}
    .folder-row{padding:11px 8px;font-size:15px}
    .folder-group summary{font-size:15px}
    .folder-count{font-size:14px}
    .panel-kicker{font-size:14px;letter-spacing:.08em;line-height:1.7}
    .entry-foot{font-size:14px}
    .collection-description,.entry-summary,.meaning,.context,.empty-collection>p:not(.empty-kicker),.no-results p,.no-script{font-size:16px}
    .search-field{padding:12px;min-width:0;width:100%;flex-basis:100%}
    .type-filters{flex-wrap:wrap}
    .type-filter{font-size:16px;min-width:0;padding:9px 7px}

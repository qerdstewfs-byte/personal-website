  @media(max-width:380px){.type-filters{gap:4px}.type-filter{flex:1 1 100%;text-align:center}.collection-heading{gap:15px}.entry-total{gap:6px}}
</style>

<script>
  const initializeLibraries = () => {
    document.querySelectorAll<HTMLElement>("[data-library-explorer]").forEach((explorer) => {
      if (explorer.classList.contains("is-enhanced")) return;
      explorer.classList.add("is-enhanced");
      const search = explorer.querySelector<HTMLInputElement>("[data-library-search]");
      const category = explorer.querySelector<HTMLSelectElement>("[data-library-category]");
      const typeButtons = explorer.querySelectorAll<HTMLButtonElement>("[data-library-type]");
      const entries = explorer.querySelectorAll<HTMLElement>("[data-library-entry]");
      const counter = explorer.querySelector<HTMLElement>("[data-library-counter]");
      const noResults = explorer.querySelector<HTMLElement>("[data-library-no-results]");
      let selectedType = "";
      const filter = () => {
        const terms = (search?.value ?? "").normalize("NFKC").toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
        let visible = 0;
        entries.forEach((entry) => {
          const matches = terms.every((term) => (entry.dataset.search ?? "").includes(term)) && (!category?.value || entry.dataset.category === category.value) && (!selectedType || entry.dataset.type === selectedType);
          entry.hidden = !matches;
          if (matches) visible++;
        });
        if (counter) counter.textContent = `${visible} ${explorer.classList.contains("with-tree") ? "篇文献" : "条记录"}`;
        if (noResults) noResults.hidden = visible !== 0;
      };
      search?.addEventListener("input", filter);
      category?.addEventListener("change", filter);
      typeButtons.forEach((button) => button.addEventListener("click", () => {
        selectedType = button.dataset.libraryType ?? "";
        typeButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        filter();
      }));
      explorer.querySelector<HTMLButtonElement>("[data-library-reset]")?.addEventListener("click", () => {
        if (search) search.value = "";
        if (category) category.value = "";
        selectedType = "";
        typeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.libraryType === "")));
        filter();
        search?.focus();
      });
    });
  };
  initializeLibraries();
  document.addEventListener("astro:page-load", initializeLibraries);
</script>

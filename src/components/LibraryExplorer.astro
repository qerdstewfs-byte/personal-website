  .folder-icon,.folder-count,.tree-chevron{flex-shrink:0}
  .folder-row>span:nth-child(2),.folder-group summary a{min-width:0}
  .folder-group summary a,.folder-row>span:not(.folder-icon),.entry-copy h3,.entry-meta,.entry-foot,.english-entry,.empty-kicker,.empty-foot{overflow-wrap:anywhere}
  .english-meta{flex-wrap:wrap;gap:8px}
  .collection-heading{align-items:flex-start;flex-wrap:wrap}

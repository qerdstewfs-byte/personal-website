---
import type { CollectionEntry } from "astro:content";
import { englishUrl, paperUrl, researchGroups, researchCategories, searchText } from "../lib/library";

interface Props {
  mode: "papers" | "english";
  papers?: CollectionEntry<"papers">[];
  english?: CollectionEntry<"english">[];
  activePath?: string;
  heading?: string;
  description?: string;
}

const { mode, papers = [], english = [], activePath = "", heading, description } = Astro.props;
const isResearch = mode === "papers";
const selectedGroup = researchGroups.find((group) => group.slug === activePath);
const selectedCategory = researchCategories.find((category) => category.path === activePath);
const visiblePapers = papers.filter((paper) => !activePath || (selectedCategory ? paper.data.category === selectedCategory.slug : selectedGroup?.categories.some((category) => category.slug === paper.data.category)));
const count = isResearch ? visiblePapers.length : english.length;
const categories = isResearch
  ? researchCategories.filter((category) => !activePath || (selectedCategory ? category.path === activePath : category.groupSlug === activePath)).map((category) => ({ value: category.slug, label: category.title }))
  : [...new Set(english.map((entry) => entry.data.category))].map((category) => ({ value: category, label: category }));
---

<div class:list={["library-explorer", { "with-tree": isResearch }]} data-library-explorer>
  {isResearch && (
    <aside class="folder-panel" aria-label="科研目录">
      <details class="directory-disclosure" open>
      <summary class="directory-heading">研究目录<span aria-hidden="true">⌄</span></summary>
      <a class:list={["all-papers", { selected: !activePath }]} href="/photoacoustic/" aria-current={!activePath ? "page" : undefined}>
        <span>全部论文</span><span class="folder-count">{papers.length}</span>
      </a>
      <nav aria-label="光声成像分类">
        {researchGroups.map((group) => (
          <details open class="folder-group">
            <summary>
              <span class="tree-chevron" aria-hidden="true"></span>
              <span class="folder-icon" aria-hidden="true"></span>
              <a href={`/photoacoustic/${group.slug}/`} class:list={{ "group-selected": activePath === group.slug }} aria-current={activePath === group.slug ? "page" : undefined}>{group.title}</a>
            </summary>
            <div class="folder-children">
              {group.categories.map((category) => {
                const path = `${group.slug}/${category.slug}`;
                const categoryCount = papers.filter((paper) => paper.data.category === category.slug).length;
                return (
                  <a class:list={["folder-row", { selected: activePath === path }]} href={`/photoacoustic/${path}/`} aria-current={activePath === path ? "page" : undefined}>
                    <span class="folder-icon" aria-hidden="true"></span><span>{category.title}</span><span class="folder-count">{categoryCount}</span>
                  </a>
                );
              })}
            </div>
          </details>
        ))}
      </nav>
      <div class="directory-note">
        <p>每篇记录包含原始资料、学习笔记和文献解读。</p>
      </div>
      </details>
    </aside>
  )}

  <section class="library-main" aria-label={isResearch ? "论文资料" : "英语学习资料"}>
    <div class="collection-heading">
      <div>
        <h2>{heading ?? (isResearch ? "全部论文" : "我的语料与单词")}</h2>
        {description && <p class="collection-description">{description}</p>}
      </div>
      <span class="entry-total">{count}<span>{isResearch ? "篇文献" : "条记录"}</span></span>
    </div>

    <div class="library-filters" role="search" aria-label={isResearch ? "搜索论文" : "搜索英语资料"}>
      <label class="search-field">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
        <span class="sr-only">{isResearch ? "搜索标题、作者、期刊或标签" : "搜索英文、释义或标签"}</span>
        <input type="search" placeholder={isResearch ? "搜索标题、作者、期刊、标签…" : "搜索英文、释义、使用场景…"} data-library-search autocomplete="off" />
      </label>
      {categories.length > 1 && (
        <label class="category-field"><span class="sr-only">选择分类</span><select data-library-category><option value="">全部分类</option>{categories.map((category) => <option value={category.value}>{category.label}</option>)}</select></label>
      )}
      {!isResearch && (
        <div class="type-filters" aria-label="资料类型">
          <button type="button" class="type-filter" data-library-type="" aria-pressed="true">全部</button>
          <button type="button" class="type-filter" data-library-type="speaking" aria-pressed="false">口语语料</button>
          <button type="button" class="type-filter" data-library-type="vocabulary" aria-pressed="false">单词</button>
        </div>
      )}
    </div>

    {count > 0 ? (
      <>
        <p class="result-counter" data-library-counter aria-live="polite">{count} {isResearch ? "篇文献" : "条记录"}</p>
        <div class:list={["entry-list", { "english-grid": !isResearch }]}>
          {isResearch ? visiblePapers.map((paper, index) => (
            <article class="paper-entry" data-library-entry data-category={paper.data.category} data-search={searchText(paper.data.title, paper.data.summary, paper.data.authors, paper.data.journal, paper.data.tags, String(paper.data.year))}>
              <div class="entry-identity"><span class="entry-number">{String(index + 1).padStart(2, "0")}</span><span class="paper-year">{paper.data.year}</span></div>
              <div class="entry-copy">
                <p class="entry-meta">{paper.data.journal} <span aria-hidden="true">/</span> {researchCategories.find((category) => category.slug === paper.data.category)?.title}</p>
                <h3><a href={paperUrl(paper)}>{paper.data.title}</a></h3>
                <p class="entry-summary">{paper.data.summary}</p>
                <div class="entry-foot"><span>{paper.data.authors.join(" · ")}</span><span class="entry-resources">{paper.data.downloads.pdf ? "原始 PDF" : ""}{paper.data.downloads.pdf && paper.data.downloads.notes ? " + " : ""}{paper.data.downloads.notes ? "学习笔记" : ""}</span></div>
                {paper.data.tags.length > 0 && <div class="entry-tags">{paper.data.tags.map((tag) => <span>{tag}</span>)}</div>}
              </div>
              <a class="entry-arrow" href={paperUrl(paper)} aria-label={`阅读 ${paper.data.title}`}><span aria-hidden="true">↗</span></a>
            </article>
          )) : english.map((entry) => (
            <article class="english-entry" data-library-entry data-category={entry.data.category} data-type={entry.data.type} data-search={searchText(entry.data.title, entry.data.meaning, entry.data.category, entry.data.context, entry.data.tags, entry.data.examples.flatMap((example) => [example.english, example.chinese ?? ""]))}>
              <div class="english-meta"><span class:list={["type-chip", entry.data.type]}>{entry.data.type === "speaking" ? "口语语料" : "单词"}</span><span>{entry.data.category}</span></div>
              <h3 lang="en"><a href={englishUrl(entry)}>{entry.data.title}</a></h3>
              <p class="meaning">{entry.data.meaning}</p>
              {entry.data.context && <p class="context">{entry.data.context}</p>}
              <div class="english-foot"><div class="entry-tags">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div><a href={englishUrl(entry)} aria-label={`查看 ${entry.data.title}`}><span aria-hidden="true">↗</span></a></div>
            </article>
          ))}
        </div>
        <div class="no-results" data-library-no-results hidden><h3>没有找到匹配的记录</h3><p>换一个关键词，或清除筛选后再看看。</p><button type="button" class="subtle-btn" data-library-reset>清除筛选</button></div>
      </>
    ) : (
      <div class="empty-collection">
        <div class="empty-art" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none"><path d="M15 10h24l10 10v34H15V10Z" stroke="currentColor" stroke-width="1.5"/><path d="M39 10v11h10M23 30h18M23 37h18M23 44h11" stroke="currentColor" stroke-width="1.5"/></svg></div>
        <h3>{isResearch ? "这个目录还没有论文" : "开始积累你的英语资料"}</h3>
        <p>{isResearch ? "提供原始 PDF 和文献学习笔记后，这里会逐篇呈现研究问题、方法、图示与创新点，并保留原文件下载入口。" : "这里将收录你的口语语料和单词。每条记录可以包含中文释义、使用场景、例句与来源，方便按主题查找。"}</p>
      </div>
    )}
    <noscript><p class="no-script">当前显示全部资料；启用 JavaScript 后可使用关键词搜索与筛选。</p></noscript>
  </section>
</div>

<style>
  a{color:inherit;text-decoration:none}.library-explorer{margin-top:28px}.with-tree{display:grid;grid-template-columns:238px minmax(0,1fr);gap:36px;align-items:start}.folder-panel{position:sticky;top:24px;min-width:0;padding-right:23px;border-right:1px solid var(--line)}
  .directory-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;list-style:none;font-size:16px;font-weight:650;line-height:1.6;cursor:pointer;margin-bottom:15px}.directory-heading::-webkit-details-marker{display:none}.directory-heading>span{color:var(--dim);font-size:20px;transition:transform .15s}.directory-disclosure:not([open])>.directory-heading>span{transform:rotate(-90deg)}
  .all-papers{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:15px;line-height:1.6;padding:10px 12px;border-radius:6px;margin-bottom:20px;color:var(--muted)}.selected{background:var(--primary-soft);color:var(--primary)!important}.folder-group{margin-bottom:21px}.folder-group summary{display:flex;align-items:center;gap:8px;list-style:none;font-size:15px;font-weight:600;line-height:1.6;cursor:pointer}.folder-group summary::-webkit-details-marker{display:none}.folder-group summary a{min-width:0;padding:5px 0;overflow-wrap:anywhere}.group-selected{color:var(--primary)}.tree-chevron{width:6px;height:6px;flex-shrink:0;border-right:1px solid var(--muted);border-bottom:1px solid var(--muted);transform:rotate(-45deg);margin-left:2px}.folder-group[open] .tree-chevron{transform:rotate(45deg)}
  .folder-icon{width:14px;height:11px;display:inline-block;flex-shrink:0;position:relative;border:1px solid currentColor;border-radius:2px;color:var(--muted)}.folder-icon::before{content:"";position:absolute;left:0;top:-4px;width:6px;height:3px;border:1px solid currentColor;border-bottom:0;border-radius:2px 2px 0 0;background:var(--bg)}.folder-children{display:grid;gap:3px;margin:6px 0 0 7px;padding-left:13px;border-left:1px solid var(--line)}.folder-row{display:flex;align-items:center;gap:9px;padding:9px 8px;color:var(--muted);border-radius:5px;font-size:15px;line-height:1.6}.folder-row>span:nth-child(2){min-width:0;overflow-wrap:anywhere}.folder-row:hover,.all-papers:hover{background:var(--surface-2)}.folder-row.selected .folder-icon{color:var(--primary)}.folder-count{font-size:14px;font-variant-numeric:tabular-nums;color:var(--dim);margin-left:auto;flex-shrink:0}.directory-note{margin-top:25px;padding-top:18px;border-top:1px solid var(--line)}.directory-note p{font-size:14px;line-height:1.8;color:var(--dim);margin:0}
  .library-main{min-width:0}.collection-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 20px;flex-wrap:wrap}.collection-heading>div{min-width:0}.collection-heading h2{font-size:23px;font-weight:650;line-height:1.5;letter-spacing:-.025em;margin:0}.collection-description{font-size:17px;line-height:1.8;color:var(--muted);max-width:650px;margin:9px 0 0}.entry-total{display:flex;gap:7px;align-items:baseline;font-size:18px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}.entry-total>span{font-size:14px;font-weight:400;color:var(--dim)}
  .library-filters{display:none;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}.library-explorer.is-enhanced .library-filters{display:flex}.search-field{display:flex;align-items:center;gap:10px;flex:1 1 280px;min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:12px 14px;color:var(--dim)}.search-field svg{flex-shrink:0}.search-field:focus-within{border-color:var(--primary);outline:2px solid var(--primary-soft)}.search-field input{width:100%;min-width:0;border:0;background:transparent;color:var(--text);font:inherit;font-size:16px;line-height:1.5;outline:none}.search-field input::placeholder{color:var(--dim)}.category-field{max-width:100%}.category-field select{max-width:100%;background:var(--surface);border:1px solid var(--line);border-radius:7px;padding:12px 30px 12px 12px;color:var(--muted);font:inherit;font-size:16px;line-height:1.5}.type-filters{display:flex;gap:5px;flex-wrap:wrap}.type-filter{background:transparent;border:1px solid transparent;color:var(--muted);font:inherit;font-size:16px;line-height:1.5;padding:11px 14px;border-radius:6px;cursor:pointer}.type-filter:hover{background:var(--surface-2)}.type-filter[aria-pressed="true"]{background:var(--primary-soft);color:var(--primary);font-weight:600}.result-counter{font-size:14px;line-height:1.7;color:var(--dim);margin:0 0 5px}
  .paper-entry{display:grid;grid-template-columns:40px minmax(0,1fr) 30px;align-items:start;gap:15px;padding:26px 0;border-bottom:1px solid var(--line)}.paper-entry:first-child{border-top:1px solid var(--line)}.entry-identity{display:grid;gap:7px;padding-top:2px}.entry-number{font-size:16px;font-variant-numeric:tabular-nums;color:var(--dim)}.paper-year{font-size:14px;font-variant-numeric:tabular-nums;color:var(--muted)}.entry-copy{min-width:0}.entry-meta{font-size:14px;line-height:1.7;color:var(--teal);margin:0 0 8px;overflow-wrap:anywhere}.entry-meta span{color:var(--dim);margin:0 5px}.entry-copy h3{font-size:22px;font-weight:600;line-height:1.5;letter-spacing:-.02em;overflow-wrap:anywhere;margin:0 0 10px}.entry-copy h3 a:hover,.english-entry h3 a:hover{color:var(--primary)}.entry-summary{font-size:17px;line-height:1.85;color:var(--muted);margin:0 0 12px;overflow-wrap:anywhere}.entry-foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 16px;font-size:14px;line-height:1.8;color:var(--dim);overflow-wrap:anywhere}.entry-resources{color:var(--teal)}.entry-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.entry-tags span{font-size:14px;line-height:1.6;color:var(--muted);background:var(--surface-2);padding:3px 8px;border-radius:4px;overflow-wrap:anywhere}.entry-arrow{display:grid;place-items:center;min-height:44px;font-size:23px;color:var(--primary)}
  .english-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:36px;border-top:1px solid var(--line)}.english-entry{display:flex;flex-direction:column;min-width:0;padding:25px 0;border-bottom:1px solid var(--line);overflow-wrap:anywhere}.english-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px;color:var(--dim);font-size:14px;line-height:1.7;margin-bottom:13px}.type-chip{font-size:14px;line-height:1.7;padding:3px 8px;border-radius:4px;background:var(--primary-soft);color:var(--teal)}.type-chip.vocabulary{color:var(--violet);background:var(--surface-2)}.english-entry h3{font-size:24px;font-weight:600;line-height:1.4;letter-spacing:-.02em;margin:0 0 10px}.meaning{font-size:17px;line-height:1.8;color:var(--muted);margin:0}.context{font-size:17px;line-height:1.8;color:var(--dim);margin:10px 0 0}.english-foot{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:auto;padding-top:10px}.english-foot>a{font-size:22px;color:var(--primary);display:grid;place-items:center;min-width:44px;min-height:44px}.english-foot .entry-tags{margin-top:0}
  .empty-collection{padding:30px 0 36px;border-top:1px solid var(--line);display:grid;grid-template-columns:52px minmax(0,1fr);column-gap:20px;align-items:start}.empty-art{grid-row:1/3;color:var(--dim);padding-top:2px}.empty-art svg{width:52px;height:52px;display:block}.empty-collection h3{font-size:21px;font-weight:600;line-height:1.5;letter-spacing:-.025em;margin:0 0 9px;overflow-wrap:anywhere}.empty-collection>p{grid-column:2;max-width:620px;font-size:17px;line-height:1.85;color:var(--muted);margin:0;overflow-wrap:anywhere}.no-results{padding:35px 0;border-top:1px solid var(--line)}.no-results h3{font-size:21px;font-weight:600;line-height:1.5;margin:0 0 10px}.no-results p,.no-script{font-size:17px;line-height:1.8;color:var(--muted)}.no-results button{margin-top:12px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}
  @media(max-width:1000px){.with-tree{grid-template-columns:215px minmax(0,1fr);gap:25px}.folder-panel{padding-right:18px}.type-filters{width:100%}.type-filter{padding:9px 13px}}
  @media(max-width:760px){.library-explorer{margin-top:24px}.with-tree{grid-template-columns:minmax(0,1fr);gap:24px}.folder-panel{position:static;border:1px solid var(--line);border-radius:7px;padding:14px 16px;background:var(--surface)}.directory-heading{margin-bottom:0}.directory-disclosure[open]>.directory-heading{margin-bottom:14px}.folder-panel nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.folder-group{margin:0}.directory-note{display:none}.all-papers{margin-bottom:14px}.folder-icon::before{background:var(--surface)}.collection-heading{margin-bottom:17px}.collection-heading h2{font-size:22px}.library-filters{gap:10px}.search-field{flex-basis:100%;padding:11px 12px}.type-filters{width:100%;gap:3px}.type-filter{padding:9px 12px}.category-field{width:100%}.category-field select{width:100%}.english-grid{grid-template-columns:minmax(0,1fr)}.entry-copy h3{font-size:20px}.paper-entry{grid-template-columns:minmax(0,1fr) 30px;gap:10px;padding:23px 0}.entry-identity{grid-column:1/-1;display:flex;gap:12px;padding:0}.entry-number,.paper-year{font-size:14px}.entry-arrow{padding-top:0}.empty-collection{grid-template-columns:36px minmax(0,1fr);gap:0 14px;padding:26px 0}.empty-art svg{width:36px;height:42px}.empty-collection h3{font-size:20px}.empty-collection>p{font-size:17px}}
  @media(max-width:520px){.folder-panel nav{grid-template-columns:minmax(0,1fr);gap:18px}.empty-collection{grid-template-columns:minmax(0,1fr)}.empty-art{grid-row:auto;margin-bottom:14px}.empty-collection>p{grid-column:auto}.type-filter{flex:1;padding-left:7px;padding-right:7px}}
</style>

<script>
  const initializeLibraries = () => {
    document.querySelectorAll<HTMLElement>("[data-library-explorer]").forEach((explorer) => {
      if (explorer.classList.contains("is-enhanced")) return;
      explorer.classList.add("is-enhanced");
      const directory = explorer.querySelector<HTMLDetailsElement>(".directory-disclosure");
      if (directory && window.matchMedia("(max-width: 760px)").matches) directory.open = false;
      const search = explorer.querySelector<HTMLInputElement>("[data-library-search]");
      const category = explorer.querySelector<HTMLSelectElement>("[data-library-category]");
      const typeButtons = explorer.querySelectorAll<HTMLButtonElement>("[data-library-type]");
      const entries = explorer.querySelectorAll<HTMLElement>("[data-library-entry]");
      const counter = explorer.querySelector<HTMLElement>("[data-library-counter]");
      const noResults = explorer.querySelector<HTMLElement>("[data-library-no-results]");
      let selectedType = "";
      const filter = () => {
        const terms = (search?.value ?? "").normalize("NFKC").toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
        let visible = 0;
        entries.forEach((entry) => {
          const matches = terms.every((term) => (entry.dataset.search ?? "").includes(term)) && (!category?.value || entry.dataset.category === category.value) && (!selectedType || entry.dataset.type === selectedType);
          entry.hidden = !matches;
          if (matches) visible++;
        });
        if (counter) counter.textContent = `${visible} ${explorer.classList.contains("with-tree") ? "篇文献" : "条记录"}`;
        if (noResults) noResults.hidden = visible !== 0;
      };
      search?.addEventListener("input", filter);
      category?.addEventListener("change", filter);
      typeButtons.forEach((button) => button.addEventListener("click", () => {
        selectedType = button.dataset.libraryType ?? "";
        typeButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        filter();
      }));
      explorer.querySelector<HTMLButtonElement>("[data-library-reset]")?.addEventListener("click", () => {
        if (search) search.value = "";
        if (category) category.value = "";
        selectedType = "";
        typeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.libraryType === "")));
        filter();
        search?.focus();
      });
    });
  };
  initializeLibraries();
  document.addEventListener("astro:page-load", initializeLibraries);
</script>

---
import type { CollectionEntry } from "astro:content";
import { englishUrl, paperUrl, researchGroups, researchCategories, searchText } from "../lib/library";

interface Props {
  mode: "papers" | "english";
  papers?: CollectionEntry<"papers">[];
  english?: CollectionEntry<"english">[];
  activePath?: string;
  heading?: string;
  description?: string;
}

const { mode, papers = [], english = [], activePath = "", heading, description } = Astro.props;
const isResearch = mode === "papers";
const selectedGroup = researchGroups.find((group) => group.slug === activePath);
const selectedCategory = researchCategories.find((category) => category.path === activePath);
const visiblePapers = papers.filter((paper) => !activePath || (selectedCategory ? paper.data.category === selectedCategory.slug : selectedGroup?.categories.some((category) => category.slug === paper.data.category)));
const count = isResearch ? visiblePapers.length : english.length;
const categories = isResearch
  ? researchCategories.filter((category) => !activePath || (selectedCategory ? category.path === activePath : category.groupSlug === activePath)).map((category) => ({ value: category.slug, label: category.title }))
  : [...new Set(english.map((entry) => entry.data.category))].map((category) => ({ value: category, label: category }));
---

<div class:list={["library-explorer", { "with-tree": isResearch }]} data-library-explorer>
  {isResearch && (
    <aside class="folder-panel" aria-label="Research directory">
      <details class="directory-disclosure" open>
      <summary class="directory-heading">Collections<span aria-hidden="true">⌄</span></summary>
      <a class:list={["all-papers", { selected: !activePath }]} href="/photoacoustic/" aria-current={!activePath ? "page" : undefined}>
        <span>All papers</span><span class="folder-count">{papers.length}</span>
      </a>
      <nav aria-label="Research categories">
        {researchGroups.map((group) => (
          <details open class="folder-group">
            <summary>
              <span class="tree-chevron" aria-hidden="true"></span>
              <span class="folder-icon" aria-hidden="true"></span>
              <a href={`/photoacoustic/${group.slug}/`} class:list={{ "group-selected": activePath === group.slug }} aria-current={activePath === group.slug ? "page" : undefined}>{group.title}</a>
            </summary>
            <div class="folder-children">
              {group.categories.map((category) => {
                const path = `${group.slug}/${category.slug}`;
                const categoryCount = papers.filter((paper) => paper.data.category === category.slug).length;
                return (
                  <a class:list={["folder-row", { selected: activePath === path }]} href={`/photoacoustic/${path}/`} aria-current={activePath === path ? "page" : undefined}>
                    <span class="folder-icon" aria-hidden="true"></span><span>{category.title}</span><span class="folder-count">{categoryCount}</span>
                  </a>
                );
              })}
            </div>
          </details>
        ))}
      </nav>
      </details>
    </aside>
  )}

  <section class="library-main" aria-label={isResearch ? "Research papers" : "English entries"}>
    <div class="collection-heading">
      <div>
        <h2>{heading ?? (isResearch ? "All papers" : "All entries")}</h2>
        {description && <p class="collection-description">{description}</p>}
      </div>
      <span class="entry-total" data-library-counter aria-live="polite">{count} {isResearch ? (count === 1 ? "paper" : "papers") : (count === 1 ? "entry" : "entries")}</span>
    </div>

    <div class="library-filters" role="search" aria-label={isResearch ? "Search papers" : "Search English entries"}>
      <label class="search-field">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
        <span class="sr-only">{isResearch ? "Search title, author, journal, or tag" : "Search English, meaning, or tag"}</span>
        <input type="search" placeholder={isResearch ? "Search papers…" : "Search entries…"} data-library-search autocomplete="off" />
      </label>
      {categories.length > 1 && (
        <label class="category-field"><span class="sr-only">Select category</span><select data-library-category><option value="">All categories</option>{categories.map((category) => <option value={category.value}>{category.label}</option>)}</select></label>
      )}
      {!isResearch && (
        <div class="type-filters" aria-label="Entry type">
          <button type="button" class="type-filter" data-library-type="" aria-pressed="true">All<span class="filter-count">{english.length}</span></button>
          <button type="button" class="type-filter" data-library-type="speaking" aria-pressed="false">Speaking<span class="filter-count">{english.filter((entry) => entry.data.type === "speaking").length}</span></button>
          <button type="button" class="type-filter" data-library-type="vocabulary" aria-pressed="false">Vocabulary<span class="filter-count">{english.filter((entry) => entry.data.type === "vocabulary").length}</span></button>
        </div>
      )}
    </div>

    {count > 0 ? (
      <>
        <div class:list={["entry-list", { "english-grid": !isResearch }]}>
          {isResearch ? visiblePapers.map((paper, index) => (
            <article class="paper-entry" data-library-entry data-category={paper.data.category} data-search={searchText(paper.data.title, paper.data.summary, paper.data.authors, paper.data.journal, paper.data.tags, String(paper.data.year))}>
              <div class="entry-identity"><span class="entry-number">{String(index + 1).padStart(2, "0")}</span><span class="paper-year">{paper.data.year}</span></div>
              <div class="entry-copy">
                <p class="entry-meta">{paper.data.journal} <span aria-hidden="true">/</span> {researchCategories.find((category) => category.slug === paper.data.category)?.title}</p>
                <h3><a href={paperUrl(paper)}>{paper.data.title}</a></h3>
                <p class="entry-summary">{paper.data.summary}</p>
                <div class="entry-foot"><span>{paper.data.authors.join(" · ")}</span><span class="entry-resources">{paper.data.downloads.pdf ? "PDF" : ""}{paper.data.downloads.pdf && paper.data.downloads.notes ? " + " : ""}{paper.data.downloads.notes ? "Notes" : ""}</span></div>
                {paper.data.tags.length > 0 && <div class="entry-tags">{paper.data.tags.map((tag) => <span>{tag}</span>)}</div>}
              </div>
              <a class="entry-arrow" href={paperUrl(paper)} aria-label={`Read ${paper.data.title}`}><span aria-hidden="true">↗</span></a>
            </article>
          )) : english.map((entry) => (
            <article class="english-entry" data-library-entry data-category={entry.data.category} data-type={entry.data.type} data-search={searchText(entry.data.title, entry.data.meaning, entry.data.category, entry.data.context, entry.data.tags, entry.data.examples.flatMap((example) => [example.english, example.chinese ?? ""]))}>
              <div class="english-meta"><span class:list={["type-chip", entry.data.type]}>{entry.data.type === "speaking" ? "Speaking" : "Vocabulary"}</span><span>{entry.data.category}</span></div>
              <h3 lang="en"><a href={englishUrl(entry)}>{entry.data.title}</a></h3>
              <p class="meaning">{entry.data.meaning}</p>
              {entry.data.context && <p class="context">{entry.data.context}</p>}
              <div class="english-foot"><div class="entry-tags">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div><a href={englishUrl(entry)} aria-label={`View ${entry.data.title}`}><span aria-hidden="true">↗</span></a></div>
            </article>
          ))}
        </div>
        <div class="no-results" data-library-no-results hidden><h3>No matching entries.</h3><button type="button" class="subtle-btn" data-library-reset>Clear filters</button></div>
      </>
    ) : (
      <div class="empty-collection"><svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 3h9l5 5v13H5V3Z"/><path d="M14 3v6h5M8 13h8M8 17h5"/></svg><p>No entries yet.</p></div>
    )}
    <noscript><p class="no-script">Enable JavaScript to search and filter.</p></noscript>
  </section>
</div>

<style>
  a{color:inherit;text-decoration:none}
  .library-explorer{padding-bottom:48px}
  .with-tree{display:grid;grid-template-columns:244px minmax(0,1fr);gap:34px;align-items:start;border-top:1px solid var(--line);padding-top:28px}
  .folder-panel{position:sticky;top:24px;min-width:0;padding-right:24px;border-right:1px solid var(--line)}
  .directory-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;list-style:none;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;line-height:1.6;cursor:pointer;color:var(--dim);margin-bottom:14px}
  .directory-heading::-webkit-details-marker{display:none}.directory-heading>span{font-size:17px;transition:transform .15s}.directory-disclosure:not([open])>.directory-heading>span{transform:rotate(-90deg)}
  .all-papers{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:14px;line-height:1.6;padding:9px 11px;border-radius:7px;margin-bottom:22px;color:var(--muted);font-weight:500}
  .selected{background:var(--primary-soft);color:var(--primary)!important}
  .folder-group{margin-bottom:20px}.folder-group:last-child{margin-bottom:0}
  .folder-group summary{display:flex;align-items:center;gap:7px;list-style:none;font-size:14px;font-weight:550;line-height:1.6;cursor:pointer}
  .folder-group summary::-webkit-details-marker{display:none}.folder-group summary a{min-width:0;padding:5px 0;overflow-wrap:anywhere}.group-selected{color:var(--primary)}
  .tree-chevron{width:5px;height:5px;flex-shrink:0;border-right:1px solid var(--dim);border-bottom:1px solid var(--dim);transform:rotate(-45deg);margin:0 2px}.folder-group[open] .tree-chevron{transform:rotate(45deg)}
  .folder-icon{width:14px;height:11px;display:inline-block;flex-shrink:0;position:relative;border:1px solid currentColor;border-radius:2px;color:var(--dim)}
  .folder-icon::before{content:"";position:absolute;left:0;top:-4px;width:6px;height:3px;border:1px solid currentColor;border-bottom:0;border-radius:2px 2px 0 0;background:var(--bg)}
  .folder-children{display:grid;gap:3px;margin:7px 0 0 5px;padding-left:12px;border-left:1px solid var(--line)}
  .folder-row{display:flex;align-items:center;gap:8px;padding:8px 9px;color:var(--muted);border-radius:6px;font-size:14px;line-height:1.5}
  .folder-row>span:nth-child(2){min-width:0;overflow-wrap:anywhere}.folder-row .folder-icon{display:none}.folder-row:hover,.all-papers:hover{background:var(--surface-2)}.folder-count{font-size:12px;font-variant-numeric:tabular-nums;color:var(--dim);margin-left:auto;flex-shrink:0}
  .library-main{min-width:0}.collection-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 18px}
  .collection-heading>div{min-width:0}.collection-heading h2{font-size:19px;font-weight:600;line-height:1.5;letter-spacing:-.03em;margin:0}
  .collection-description{font-size:16px;line-height:1.7;color:var(--muted);max-width:650px;margin:8px 0 0}
  .entry-total{font-size:12px;font-weight:400;color:var(--dim);font-variant-numeric:tabular-nums;white-space:nowrap}
  .library-filters{display:none;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:20px}.library-explorer.is-enhanced .library-filters{display:flex}
  .search-field{display:flex;align-items:center;gap:10px;flex:1 1 220px;min-width:0;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:11px 13px;color:var(--dim);min-height:44px}
  .search-field svg{flex-shrink:0;width:17px;height:17px}.search-field:focus-within{border-color:var(--primary);box-shadow:0 0 0 3px var(--primary-soft)}
  .search-field input{width:100%;min-width:0;border:0;background:transparent;color:var(--text);font:inherit;font-size:15px;line-height:1.4;outline:none}.search-field input::placeholder{color:var(--dim)}
  .category-field{max-width:100%}.category-field select{max-width:100%;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:11px 28px 11px 12px;color:var(--muted);font:inherit;font-size:14px;line-height:1.4;min-height:44px}
  .type-filters{display:flex;gap:3px;padding:4px;background:var(--surface-2);border:1px solid var(--line);border-radius:9px}
  .type-filter{display:flex;align-items:center;gap:8px;background:transparent;border:1px solid transparent;color:var(--muted);font:inherit;font-size:13px;line-height:1.4;padding:7px 12px;border-radius:6px;cursor:pointer;white-space:nowrap}
  .type-filter:hover{color:var(--text)}.type-filter[aria-pressed="true"]{background:var(--surface);border-color:var(--line);color:var(--text);font-weight:550;box-shadow:0 1px 3px #00000008}
  .filter-count{font-size:11px;color:var(--dim);font-variant-numeric:tabular-nums}
  .paper-entry{display:grid;grid-template-columns:36px minmax(0,1fr) 32px;align-items:start;gap:16px;padding:25px 0;border-bottom:1px solid var(--line)}.paper-entry:first-child{border-top:1px solid var(--line)}
  .entry-identity{display:grid;gap:8px;padding-top:2px}.entry-number{font-size:13px;font-variant-numeric:tabular-nums;color:var(--dim)}.paper-year{font-size:12px;color:var(--dim)}.entry-copy{min-width:0}
  .entry-meta{font-size:13px;line-height:1.7;color:var(--primary);margin:0 0 7px;overflow-wrap:anywhere}.entry-meta span{color:var(--dim);margin:0 4px}
  .entry-copy h3{font-size:22px;font-weight:550;line-height:1.45;letter-spacing:-.03em;overflow-wrap:anywhere;margin:0 0 10px}.entry-copy h3 a:hover,.english-entry h3 a:hover{color:var(--primary)}
  .entry-summary{font-size:17px;line-height:1.75;color:var(--muted);margin:0 0 12px;overflow-wrap:anywhere}.entry-foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 16px;font-size:12px;line-height:1.8;color:var(--dim);overflow-wrap:anywhere}.entry-resources{color:var(--muted)}
  .entry-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.entry-tags span{font-size:12px;line-height:1.6;color:var(--muted);background:var(--surface-2);border:1px solid var(--line);padding:2px 7px;border-radius:5px;overflow-wrap:anywhere}
  .entry-arrow{display:grid;place-items:center;width:32px;min-height:36px;font-size:21px;color:var(--dim);border:1px solid var(--line);border-radius:7px}.entry-arrow:hover{color:var(--primary);background:var(--primary-soft)}
  .english-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .english-entry{display:flex;flex-direction:column;min-width:0;padding:24px;border:1px solid var(--line);border-radius:12px;background:var(--surface);box-shadow:var(--shadow);overflow-wrap:anywhere}
  .english-meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px;color:var(--dim);font-size:12px;line-height:1.7;margin-bottom:14px}.type-chip{font-size:11px;padding:2px 7px;border-radius:5px;background:var(--primary-soft);color:var(--primary)}.type-chip.vocabulary{color:var(--muted);background:var(--surface-2)}
  .english-entry h3{font-size:24px;font-weight:550;line-height:1.4;letter-spacing:-.035em;margin:0 0 12px}.meaning{font-size:17px;line-height:1.75;color:var(--text);margin:0}.context{font-size:16px;line-height:1.75;color:var(--muted);margin:12px 0 0}
  .english-foot{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-top:auto;padding-top:20px}.english-foot>a{font-size:20px;color:var(--dim);display:grid;place-items:center;min-width:36px;min-height:36px}.english-foot .entry-tags{margin-top:0}
  .empty-collection{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:13px;min-height:180px;padding:32px 16px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;color:var(--dim)}
  .empty-collection svg{opacity:.6}.empty-collection p{font-size:15px;line-height:1.6;margin:0}
  .no-results{padding:36px 20px;text-align:center;border:1px solid var(--line);border-radius:12px;background:var(--surface-2)}.no-results h3{font-size:17px;font-weight:500;line-height:1.5;margin:0 0 16px}.no-script{font-size:16px;color:var(--muted)}
  @media(max-width:1000px){.with-tree{grid-template-columns:215px minmax(0,1fr);gap:24px}.folder-panel{padding-right:18px}.type-filters{flex-wrap:wrap}.english-entry{padding:20px}}
  @media(max-width:760px){
    .library-explorer{padding-bottom:24px}.with-tree{grid-template-columns:minmax(0,1fr);gap:24px;padding-top:0;border-top:0}
    .folder-panel{position:static;border:1px solid var(--line);border-radius:9px;padding:13px 15px;background:var(--surface)}
    .directory-heading{margin:0;font-size:13px;letter-spacing:0;text-transform:none;color:var(--text)}.directory-disclosure[open]>.directory-heading{margin-bottom:14px}
    .folder-panel nav{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.folder-group{margin:0}.all-papers{margin-bottom:14px}
    .collection-heading{margin-bottom:14px}.collection-heading h2{font-size:18px}.library-filters{gap:10px}.search-field{flex-basis:100%}.search-field input{font-size:16px}.type-filters{width:100%}.type-filter{justify-content:center;flex:1;padding:8px 9px}.category-field{width:100%}.category-field select{width:100%;font-size:16px}
    .english-grid{grid-template-columns:minmax(0,1fr)}.entry-copy h3{font-size:20px}.paper-entry{grid-template-columns:minmax(0,1fr) 32px;gap:10px;padding:23px 0}.entry-identity{grid-column:1/-1;display:flex;gap:12px;padding:0}.empty-collection{min-height:150px}
  }
  @media(max-width:480px){.folder-panel nav{grid-template-columns:minmax(0,1fr);gap:18px}.type-filter{font-size:13px;gap:5px;padding-inline:6px}.english-entry{padding:20px}.english-entry h3{font-size:23px}}
</style>

<script>
  const initializeLibraries = () => {
    document.querySelectorAll<HTMLElement>("[data-library-explorer]").forEach((explorer) => {
      if (explorer.classList.contains("is-enhanced")) return;
      explorer.classList.add("is-enhanced");
      const directory = explorer.querySelector<HTMLDetailsElement>(".directory-disclosure");
      if (directory && window.matchMedia("(max-width: 760px)").matches) directory.open = false;
      const search = explorer.querySelector<HTMLInputElement>("[data-library-search]");
      const category = explorer.querySelector<HTMLSelectElement>("[data-library-category]");
      const typeButtons = explorer.querySelectorAll<HTMLButtonElement>("[data-library-type]");
      const entries = explorer.querySelectorAll<HTMLElement>("[data-library-entry]");
      const counter = explorer.querySelector<HTMLElement>("[data-library-counter]");
      const noResults = explorer.querySelector<HTMLElement>("[data-library-no-results]");
      let selectedType = "";
      const filter = () => {
        const terms = (search?.value ?? "").normalize("NFKC").toLocaleLowerCase().trim().split(/\s+/).filter(Boolean);
        let visible = 0;
        entries.forEach((entry) => {
          const matches = terms.every((term) => (entry.dataset.search ?? "").includes(term)) && (!category?.value || entry.dataset.category === category.value) && (!selectedType || entry.dataset.type === selectedType);
          entry.hidden = !matches;
          if (matches) visible++;
        });
        if (counter) counter.textContent = `${visible} ${explorer.classList.contains("with-tree") ? (visible === 1 ? "paper" : "papers") : (visible === 1 ? "entry" : "entries")}`;
        if (noResults) noResults.hidden = visible !== 0;
      };
      search?.addEventListener("input", filter);
      category?.addEventListener("change", filter);
      typeButtons.forEach((button) => button.addEventListener("click", () => {
        selectedType = button.dataset.libraryType ?? "";
        typeButtons.forEach((other) => other.setAttribute("aria-pressed", String(other === button)));
        filter();
      }));
      explorer.querySelector<HTMLButtonElement>("[data-library-reset]")?.addEventListener("click", () => {
        if (search) search.value = "";
        if (category) category.value = "";
        selectedType = "";
        typeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.libraryType === "")));
        filter();
        search?.focus();
      });
    });
  };
  initializeLibraries();
  document.addEventListener("astro:page-load", initializeLibraries);
</script>

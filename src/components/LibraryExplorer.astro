ze:18px}.directory-note p{font-size:14px;line-height:1.9;color:var(--dim);margin:0}.library-main{min-width:0}.collection-heading{display:flex;justify-content:space-between;gap:25px;align-items:center;margin:4px 0 25px}.collection-heading .panel-kicker{margin-bottom:8px}.collection-heading h2{font-size:25px;letter-spacing:-.03em;margin:0}.collection-description{font-size:14px;line-height:1.8;color:var(--muted);max-width:620px;margin:10px 0 0}.entry-total{font:32px "JetBrains Mono",monospace;color:var(--text);display:flex;align-items:baseline;gap:7px}.entry-total>span{font-size:14px;font-family:inherit;color:var(--dim);white-space:nowrap}.library-filters{display:none;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:21px}.library-explorer.is-enhanced .library-filters{display:flex}.search-field{display:flex;align-items:center;gap:10px;flex:1;min-width:220px;border:1px solid var(--line);border-radius:10px;padding:11px 14px;background:var(--surface);color:var(--dim)}.search-field:focus-within{border-color:var(--primary)}.search-field input{width:100%;min-width:0;border:0;background:transparent;color:var(--text);font:inherit;font-size:14px;outline:none}.search-field input::placeholder{color:var(--dim)}.category-field select{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:11px 31px 11px 12px;color:var(--muted);font:inherit;font-size:14px}.type-filters{display:flex;gap:3px;background:var(--surface);padding:4px;border:1px solid var(--line);border-radius:10px}.type-filter{background:transparent;border:0;color:var(--muted);font:inherit;font-size:14px;padding:8px 12px;border-radius:6px;cursor:pointer}.type-filter[aria-pressed="true"]{background:var(--surface-2);color:var(--text)}.result-counter{color:var(--dim);font-size:14px;margin:0 0 12px}.paper-entry{display:grid;grid-template-columns:40px minmax(0,1fr) 24px;gap:15px;padding:25px 0;border-top:1px solid var(--line);align-items:start}.entry-identity{display:flex;flex-direction:column;gap:10px}.entry-number{font:17px "JetBrains Mono",monospace;color:var(--dim)}.paper-year{font:14px "JetBrains Mono",monospace;color:var(--muted)}.entry-meta{font-size:14px;letter-spacing:.025em;color:var(--teal);margin:0 0 9px;line-height:1.7}.entry-meta span{color:var(--dim);margin:0 5px}.entry-copy h3{font-size:18px;line-height:1.5;letter-spacing:-.02em;margin:0 0 10px}.entry-copy h3 a:hover,.english-entry h3 a:hover{color:var(--primary)}.entry-summary{font-size:14px;line-height:1.9;color:var(--muted);margin:0 0 13px}.entry-foot{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;font-size:14px;color:var(--dim);line-height:1.8}.entry-resources{color:var(--teal)}.entry-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.entry-tags span{font-size:14px;color:var(--muted);padding:4px 7px;border:1px solid var(--line);border-radius:5px}.entry-arrow{font-size:22px;color:var(--primary);padding-top:12px}.english-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.english-entry{padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--surface);display:flex;flex-direction:column}.english-meta{display:flex;justify-content:space-between;gap:12px;align-items:center;color:var(--dim);font-size:14px;margin-bottom:20px}.type-chip{font-size:14px;padding:5px 8px;border-radius:5px;background:color-mix(in srgb,var(--teal) 10%,transparent);color:var(--teal)}.type-chip.vocabulary{color:var(--violet);background:color-mix(in srgb,var(--violet) 10%,transparent)}.english-entry h3{font-size:23px;line-height:1.4;margin:0 0 12px;letter-spacing:-.03em;overflow-wrap:anywhere}.meaning{font-size:14px;line-height:1.8;color:var(--muted);margin:0}.context{font-size:14px;line-height:1.8;color:var(--dim);margin:10px 0 0}.english-foot{display:flex;justify-content:space-between;gap:10px;align-items:end;margin-top:auto;padding-top:20px}.english-foot>a{font-size:20px;color:var(--primary)}.empty-collection{position:relative;min-height:365px;padding:38px 25px 40px;display:flex;align-items:center;flex-direction:column;text-align:center;border:1px solid var(--line);border-radius:18px;background:var(--surface);overflow:hidden}.empty-art{position:relative;width:96px;height:90px;display:grid;place-items:center;margin-bottom:10px}.empty-art svg{width:52px;height:52px;color:var(--muted);z-index:1}.empty-art span{position:absolute;width:90px;height:90px;border:1px solid var(--line);border-radius:50%;transform:rotate(-15deg)}.empty-art span:nth-child(2){width:110px;height:50px;transform:rotate(25deg);border-color:color-mix(in srgb,var(--teal) 25%,var(--line))}.empty-kicker{font:14px "JetBrains Mono",monospace;letter-spacing:.16em;color:var(--teal);margin:10px 0 15px}.empty-collection h3{font-size:20px;letter-spacing:-.03em;margin:0 0 15px}.empty-collection>p:not(.empty-kicker){font-size:14px;line-height:2;color:var(--muted);max-width:450px;margin:0}.empty-foot{margin-top:25px;padding-top:20px;border-top:1px solid var(--line);color:var(--dim);font-size:14px;letter-spacing:.06em;width:min(100%,380px)}.no-results{padding:55px 15px;text-align:center}.no-results h3{font-size:18px}.no-results p,.no-script{font-size:14px;color:var(--muted);line-height:1.8}.no-results button{margin-top:15px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}
  @media(max-width:1100px){.with-tree{grid-template-columns:230px minmax(0,1fr);gap:24px}.english-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.entry-copy h3{font-size:16px}}
  @media(max-width:760px){.with-tree{grid-template-columns:1fr;gap:26px}.folder-panel{position:static;padding:18px 16px}.folder-panel nav{display:grid;grid-template-columns:1fr 1fr;gap:12px}.folder-panel .directory-note{display:none}.folder-group{margin-bottom:0}.panel-kicker{font-size:14px}.all-papers{margin-bottom:12px}.collection-heading h2{font-size:22px}.collection-heading{gap:12px}.entry-total{font-size:25px}.empty-collection{padding:30px 20px;min-height:330px}.empty-collection h3{font-size:18px}.english-grid{grid-template-columns:1fr}.library-explorer{margin-top:25px}.entry-foot{font-size:14px}.paper-entry{grid-template-columns:28px minmax(0,1fr) 18px;gap:10px}.folder-row{font-size:14px;padding:10px 5px}.folder-group summary{font-size:14px;gap:6px}.folder-children{margin-left:16px;padding-left:5px}.folder-count{font-size:14px}.type-filters{width:100%}.type-filter{flex:1}.search-field{min-width:100%}.category-field{flex:1}.category-field select{width:100%}}

  /* Keep reading text and controls comfortable at every breakpoint. */

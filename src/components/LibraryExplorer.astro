---
import type { CollectionEntry } from "astro:content";
import { englishUrl, paperUrl, researchGroups, researchCategories, searchText } from "../lib/library";

interface Props {
  mode: "papers" | "english";
  papers?: CollectionEntry<"papers">[];
  english?: CollectionEntry<"english">[];
  activePath?: string;
  heading?: string;
  description?: string;
}

const { mode, papers = [], english = [], activePath = "", heading, description } = Astro.props;
const isResearch = mode === "papers";
const selectedGroup = researchGroups.find((group) => group.slug === activePath);
const selectedCategory = researchCategories.find((category) => category.path === activePath);
const visiblePapers = papers.filter((paper) => !activePath || (selectedCategory ? paper.data.category === selectedCategory.slug : selectedGroup?.categories.some((category) => category.slug === paper.data.category)));
const count = isResearch ? visiblePapers.length : english.length;
const categories = isResearch
  ? researchCategories.filter((category) => !activePath || (selectedCategory ? category.path === activePath : category.groupSlug === activePath)).map((category) => ({ value: category.slug, label: category.title }))
  : [...new Set(english.map((entry) => entry.data.category))].map((category) => ({ value: category, label: category }));
---

<div class:list={["library-explorer", { "with-tree": isResearch }]} data-library-explorer>
  {isResearch && (
    <aside class="folder-panel" aria-label="科研目录">
      <p class="panel-kicker">RESEARCH DIRECTORY</p>
      <a class:list={["all-papers", { selected: !activePath }]} href="/photoacoustic/" aria-current={!activePath ? "page" : undefined}>
        <span>全部论文</span><span class="folder-count">{papers.length}</span>
      </a>
      <nav aria-label="光声成像分类">
        {researchGroups.map((group) => (
          <details open class="folder-group">
            <summary>
              <span class="tree-chevron" aria-hidden="true"></span>
              <span class="folder-icon" aria-hidden="true"></span>
              <a href={`/photoacoustic/${group.slug}/`} class:list={{ "group-selected": activePath === group.slug }} aria-current={activePath === group.slug ? "page" : undefined}>{group.title}</a>
            </summary>
            <div class="folder-children">
              {group.categories.map((category) => {
                const path = `${group.slug}/${category.slug}`;
                const categoryCount = papers.filter((paper) => paper.data.category === category.slug).length;
                return (
                  <a class:list={["folder-row", { selected: activePath === path }]} href={`/photoacoustic/${path}/`} aria-current={activePath === path ? "page" : undefined}>
                    <span class="folder-icon" aria-hidden="true"></span><span>{category.title}</span><span class="folder-count">{categoryCount}</span>
                  </a>
                );
              })}
            </div>
          </details>
        ))}
      </nav>
      <div class="directory-note">
        <span class="note-mark" aria-hidden="true">↗</span>
        <p>原论文、学习笔记与文献解读，<br />在同一篇记录中相互对应。</p>
      </div>
    </aside>
  )}

  <section class="library-main" aria-label={isResearch ? "论文资料" : "英语学习资料"}>
    <div class="collection-heading">
      <div>
        <p class="panel-kicker">{isResearch ? "PAPER COLLECTION" : "LEARNING COLLECTION"}</p>
        <h2>{heading ?? (isResearch ? "全部论文" : "我的语料与单词")}</h2>
        {description && <p class="collection-description">{description}</p>}
      </div>
      <span class="entry-total">{count}<span>{isResearch ? "篇文献" : "条记录"}</span></span>
    </div>

    <div class="library-filters" role="search" aria-label={isResearch ? "搜索论文" : "搜索英语资料"}>
      <label class="search-field">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg>
        <span class="sr-only">{isResearch ? "搜索标题、作者、期刊或标签" : "搜索英文、释义或标签"}</span>
        <input type="search" placeholder={isResearch ? "搜索标题、作者、期刊、标签…" : "搜索英文、释义、使用场景…"} data-library-search autocomplete="off" />
      </label>
      {categories.length > 1 && (
        <label class="category-field"><span class="sr-only">选择分类</span><select data-library-category><option value="">全部分类</option>{categories.map((category) => <option value={category.value}>{category.label}</option>)}</select></label>
      )}
      {!isResearch && (
        <div class="type-filters" aria-label="资料类型">
          <button type="button" class="type-filter" data-library-type="" aria-pressed="true">全部</button>
          <button type="button" class="type-filter" data-library-type="speaking" aria-pressed="false">口语语料</button>
          <button type="button" class="type-filter" data-library-type="vocabulary" aria-pressed="false">单词</button>
        </div>
      )}
    </div>

    {count > 0 ? (
      <>
        <p class="result-counter" data-library-counter aria-live="polite">{count} {isResearch ? "篇文献" : "条记录"}</p>
        <div class:list={["entry-list", { "english-grid": !isResearch }]}>
          {isResearch ? visiblePapers.map((paper) => (
            <article class="paper-entry" data-library-entry data-category={paper.data.category} data-search={searchText(paper.data.title, paper.data.summary, paper.data.authors, paper.data.journal, paper.data.tags, String(paper.data.year))}>
              <div class="entry-identity"><span class="entry-number">{String(visiblePapers.indexOf(paper) + 1).padStart(2, "0")}</span><span class="paper-year">{paper.data.year}</span></div>
              <div class="entry-copy">
                <p class="entry-meta">{paper.data.journal} <span aria-hidden="true">/</span> {researchCategories.find((category) => category.slug === paper.data.category)?.title}</p>
                <h3><a href={paperUrl(paper)}>{paper.data.title}</a></h3>
                <p class="entry-summary">{paper.data.summary}</p>
                <div class="entry-foot"><span>{paper.data.authors.join(" · ")}</span><span class="entry-resources">{paper.data.downloads.pdf ? "原始 PDF" : ""}{paper.data.downloads.pdf && paper.data.downloads.notes ? " + " : ""}{paper.data.downloads.notes ? "学习笔记" : ""}</span></div>
                {paper.data.tags.length > 0 && <div class="entry-tags">{paper.data.tags.map((tag) => <span>{tag}</span>)}</div>}
              </div>
              <a class="entry-arrow" href={paperUrl(paper)} aria-label={`阅读 ${paper.data.title}`}><span aria-hidden="true">↗</span></a>
            </article>
          )) : english.map((entry) => (
            <article class="english-entry" data-library-entry data-category={entry.data.category} data-type={entry.data.type} data-search={searchText(entry.data.title, entry.data.meaning, entry.data.category, entry.data.context, entry.data.tags, entry.data.examples.flatMap((example) => [example.english, example.chinese ?? ""]))}>
              <div class="english-meta"><span class:list={["type-chip", entry.data.type]}>{entry.data.type === "speaking" ? "口语语料" : "单词"}</span><span>{entry.data.category}</span></div>
              <h3 lang="en"><a href={englishUrl(entry)}>{entry.data.title}</a></h3>
              <p class="meaning">{entry.data.meaning}</p>
              {entry.data.context && <p class="context">{entry.data.context}</p>}
              <div class="english-foot"><div class="entry-tags">{entry.data.tags.map((tag) => <span>{tag}</span>)}</div><a href={englishUrl(entry)} aria-label={`查看 ${entry.data.title}`}><span aria-hidden="true">↗</span></a></div>
            </article>
          ))}
        </div>
        <div class="no-results" data-library-no-results hidden><h3>没有找到匹配的记录</h3><p>换一个关键词，或清除筛选后再看看。</p><button type="button" class="subtle-btn" data-library-reset>清除筛选</button></div>
      </>
    ) : (
      <div class="empty-collection">
        <div class="empty-art" aria-hidden="true"><span></span><span></span><svg viewBox="0 0 64 64" fill="none"><path d="M15 10h24l10 10v34H15V10Z" stroke="currentColor" stroke-width="1.5"/><path d="M39 10v11h10M23 30h18M23 37h18M23 44h11" stroke="currentColor" stroke-width="1.5"/></svg></div>
        <p class="empty-kicker">{isResearch ? "A PLACE FOR THE NEXT DISCOVERY" : "WORDS WORTH KEEPING"}</p>
        <h3>{isResearch ? "目录已准备好，等待第一篇论文" : "把想说的话，慢慢变成自己的表达"}</h3>
        <p>{isResearch ? "提供原始 PDF 和文献学习笔记后，这里会逐篇呈现研究问题、方法、图示与创新点，并保留原文件下载入口。" : "这里将收录你的口语语料和单词。每条记录可以包含中文释义、使用场景、例句与来源，方便按主题查找。"}</p>
        <div class="empty-foot">{isResearch ? "原始资料 → 学习笔记 → 图文解读" : "口语语料 · 单词 · 分类检索"}</div>
      </div>
    )}
    <noscript><p class="no-script">当前显示全部资料；启用 JavaScript 后可使用关键词搜索与筛选。</p></noscript>
  </section>
</div>

<style>

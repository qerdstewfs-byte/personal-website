---
import type { CollectionEntry } from "astro:content";
import { paperCategory } from "../lib/library";
interface Props { paper: CollectionEntry<"papers">; }
const { paper } = Astro.props;
const data = paper.data;
const presentation = data.presentation!;
const category = paperCategory(data.category);
const downloads = [
  { file: data.downloads.pdf, title: "Original PDF" },
  { file: data.downloads.notes, title: "Reading notes" },
];
---

<article class="presentation-page">
  <nav class="paper-breadcrumbs" aria-label="Breadcrumb"><a href="/photoacoustic/">Photoacoustic Imaging</a><span>/</span><a href={`/photoacoustic/${category.path}/`}>{category.title}</a><span>/</span><span aria-current="page">{data.authors[0].split(" ").at(-1)} et al., {data.year}</span></nav>
  <header class="paper-heading">
    <div><p>{data.journal} <span>·</span> {data.year}</p><h1>{presentation.title}</h1></div>
    <div class="paper-downloads" aria-label="Source downloads">{downloads.map(({ file, title }) => file && <a class="subtle-btn" href={file.url} download={file.label}>{title} <span aria-hidden="true">↓</span><small>{file.size}</small></a>)}</div>
  </header>

  <section class="paper-deck" data-paper-deck aria-label="Paper presentation" tabindex="-1">
    <div class="deck-toolbar" data-deck-controls hidden>
      <label class="slide-picker"><span class="sr-only">Choose a slide</span><select data-slide-picker>{presentation.slides.map((slide, index) => <option value={slide.id}>{String(index + 1).padStart(2, "0")} / {slide.title}</option>)}</select></label>
      <div class="deck-actions"><button class="subtle-btn" data-reading-toggle aria-pressed="false">Read all</button><button class="subtle-btn" data-present-toggle aria-pressed="false">Fullscreen</button></div>
    </div>
    <div class="deck-stage">
      {presentation.slides.map((slide, index) => <section class:list={["paper-slide", `layout-${slide.layout}`]} id={`slide-${slide.id}`} data-slide={slide.id} aria-labelledby={`heading-${slide.id}`}>
        <div class="slide-body">
          <header class="slide-heading"><p class="slide-section">{slide.section}</p><h2 id={`heading-${slide.id}`}>{slide.title}</h2></header>
          <div class="slide-composition">
            <div class="slide-copy">
              {slide.lead && <p class="slide-lead">{slide.lead}</p>}
              {slide.layout === "cover" && <div class="cover-publication"><p>{data.title}</p><p>{data.journal} ({data.year})</p><p>{data.authors.join(", ")}</p>{data.doi && <a href={`https://doi.org/${data.doi}`} target="_blank" rel="noopener noreferrer">DOI {data.doi} ↗</a>}</div>}
              {slide.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {slide.points.length > 0 && <dl class="slide-points">{slide.points.map((point) => <div><dt>{point.label}</dt><dd>{point.text}</dd></div>)}</dl>}
              {slide.metrics.length > 0 && <dl class="slide-metrics">{slide.metrics.map((metric) => <div><dt>{metric.value}</dt><dd>{metric.label}</dd></div>)}</dl>}
              {slide.layout === "references" && <>
                <div class="source-files">{downloads.map(({ file, title }) => file && <a href={file.url} download={file.label}><span>{title}</span><small>{file.size} · PDF</small><span aria-hidden="true">↓</span></a>)}</div>
                <ol class="deck-references">{data.references.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></li>)}</ol>
              </>}
            </div>
            {slide.figureIds.length > 0 && <div class:list={["slide-figures", { "figure-pair": slide.figureIds.length > 1 }]}>{slide.figureIds.map((id) => {
              const figure = data.figures.find((item) => item.id === id)!;
              return <figure><a href={figure.src} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size image: ${figure.alt}`}><img src={figure.src} alt={figure.alt} width={figure.width} height={figure.height} loading={index === 0 ? "eager" : "lazy"} decoding="async" /></a><figcaption><span>{figure.caption}</span><small>{figure.attribution}</small></figcaption></figure>;
            })}</div>}
          </div>
          {slide.flow.length > 0 && <ol class="science-flow" aria-label="Method steps">{slide.flow.map((step, stepIndex) => <li><span class="flow-number">{String(stepIndex + 1).padStart(2, "0")}</span><strong>{step.label}</strong><p>{step.text}</p>{stepIndex < slide.flow.length - 1 && <span class="flow-direction" aria-hidden="true">→</span>}</li>)}</ol>}
          {slide.relation && <p class="slide-relation">{slide.relation}</p>}
          {slide.takeaway && <p class="slide-takeaway">{slide.takeaway}</p>}
          {slide.sources.length > 0 && <div class="slide-sources">{slide.sources.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a>)}</div>}
        </div>
        <footer class="slide-footnote"><span>{slide.sourcePage && data.downloads.pdf ? <a href={`${data.downloads.pdf.url}#page=${slide.sourcePage}`} target="_blank" rel="noopener noreferrer">{slide.sourceNote}</a> : slide.sourceNote}</span><span>{String(index + 1).padStart(2, "0")}</span></footer>
      </section>)}
    </div>
    <div class="deck-bottom" data-deck-controls hidden><p class="keyboard-hint">Use ← → to navigate</p><div class="deck-pagination"><button class="subtle-btn" data-slide-prev aria-label="Previous slide">← <span>Previous</span></button><span class="slide-count" data-slide-count role="status" aria-live="polite" aria-atomic="true">1 / {presentation.slides.length}</span><button class="filled-btn" data-slide-next aria-label="Next slide"><span>Next</span> →</button></div></div>
    <p class="sr-only" data-deck-message role="status"></p>
  </section>
  <p class="report-return"><a href={`/photoacoustic/${category.path}/`}>← Back to {category.title}</a><span>{presentation.slides.length} slides</span></p>
</article>

<script src="../scripts/paper-presentation.ts"></script>

<style>
  .presentation-page{padding:24px 0 10px}a{text-decoration:none}.paper-breadcrumbs{display:flex;flex-wrap:wrap;gap:9px;font-size:13px;color:var(--dim)}.paper-breadcrumbs a{color:inherit}.paper-breadcrumbs a:hover{color:var(--primary)}.paper-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:25px 0}.paper-heading p{margin:0 0 6px;font-size:14px;color:var(--dim)}.paper-heading p span{margin:0 7px}.paper-heading h1{margin:0;font-size:29px;font-weight:600;letter-spacing:-.045em}.paper-downloads{display:flex;gap:8px;flex-wrap:wrap}.paper-downloads small{font-size:11px;color:var(--dim)}
  .paper-deck{border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--surface);outline-offset:5px}.deck-toolbar{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:12px 20px;border-bottom:1px solid var(--line);background:var(--surface-2)}.slide-picker{min-width:0;max-width:65%;flex:1}.slide-picker select{width:100%;border:0;background:transparent;color:var(--text);font-size:14px;font-weight:550;min-height:38px;padding:0 8px;cursor:pointer;text-overflow:ellipsis}.deck-actions{display:flex;gap:6px}.deck-actions button{font-size:13px;min-height:36px;padding:7px 11px}.deck-actions button[aria-pressed="true"]{background:var(--primary-soft);border-color:var(--primary);color:var(--primary)}
  .paper-slide{display:flex;flex-direction:column;min-height:660px;padding:36px 44px 18px;scroll-margin-top:20px}.paper-slide+.paper-slide{border-top:1px solid var(--line)}.paper-deck[data-mode="slides"] .paper-slide{height:690px;min-height:0;overflow-y:auto;border:0}.slide-body{flex:1}.slide-heading{margin-bottom:28px}.slide-section{font-size:12px;letter-spacing:.11em;font-weight:600;text-transform:uppercase;color:var(--primary);margin:0 0 10px}.slide-heading h2{font-size:clamp(26px,3vw,36px);line-height:1.16;letter-spacing:-.04em;font-weight:600;margin:0;max-width:940px}.slide-composition{display:grid;grid-template-columns:minmax(0,1fr);gap:32px;align-items:center}.layout-split .slide-composition{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}.layout-wide .slide-composition{grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr)}.slide-copy{min-width:0}.slide-copy>p{font-size:17px;line-height:1.7;color:var(--muted);margin:0 0 18px}.slide-copy>p.slide-lead{font-size:21px;line-height:1.5;color:var(--text);letter-spacing:-.015em}.slide-points{margin:20px 0 0;display:grid;gap:19px}.slide-points>div{min-width:0}.slide-points dt{font-size:15px;font-weight:600;margin-bottom:5px;color:var(--text)}.slide-points dd{font-size:16px;line-height:1.65;color:var(--muted);margin:0}.layout-text .slide-points{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 38px}.layout-text .slide-points>div{padding-top:17px;border-top:1px solid var(--line)}.layout-text .slide-points dt{font-size:18px}.layout-text .slide-points dd{font-size:17px}.slide-metrics{display:flex;gap:22px 36px;flex-wrap:wrap;margin:24px 0 0}.slide-metrics>div{flex:1;min-width:95px}.slide-metrics dt{font-size:32px;font-weight:550;letter-spacing:-.05em;line-height:1.3;color:var(--primary)}.slide-metrics dd{margin:6px 0 0;font-size:13px;line-height:1.5;color:var(--muted);max-width:200px}
  .slide-figures{min-width:0;display:grid;gap:18px;align-items:start}.slide-figures.figure-pair{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.slide-figures figure{margin:0;min-width:0}.slide-figures figure>a{display:block;background:white}.slide-figures img{display:block;width:100%;height:auto;max-height:385px;object-fit:contain}.slide-figures figcaption{margin-top:12px;font-size:13px;line-height:1.55;color:var(--muted)}.slide-figures figcaption small{display:block;font-size:11px;color:var(--dim);margin-top:4px}.slide-takeaway{font-size:17px;line-height:1.6;color:var(--text);border-left:3px solid var(--primary);padding:2px 0 2px 16px;margin:26px 0 4px;max-width:980px}.slide-sources{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:22px}.slide-sources a{font-size:13px}.slide-footnote{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;border-top:1px solid var(--line);margin-top:30px;padding-top:13px;font-size:11px;line-height:1.5;color:var(--dim)}.slide-footnote a{color:inherit}.slide-footnote a:hover{text-decoration:underline}.slide-footnote>span:last-child{font-variant-numeric:tabular-nums;letter-spacing:.03em;font-size:12px}
  .layout-cover .slide-heading{margin:8px 0 30px}.layout-cover .slide-heading h2{font-size:clamp(34px,4vw,46px);max-width:810px;line-height:1.13}.layout-cover .slide-composition{grid-template-columns:minmax(0,1fr) minmax(0,.62fr);gap:60px}.layout-cover .slide-copy>.slide-lead{font-size:23px;line-height:1.5}.cover-publication{margin:25px 0 0;font-size:13px;color:var(--dim);max-width:520px}.cover-publication p{margin:0 0 8px}.cover-publication a{font-size:12px}.layout-cover .slide-figures img{max-height:300px}.layout-cover .slide-figures figure>a{background:white}.layout-cover .slide-metrics dt{font-size:27px}
  .science-flow{display:grid;grid-template-columns:repeat(auto-fit,minmax(135px,1fr));gap:30px;list-style:none;padding:0;margin:34px 0 20px}.science-flow li{position:relative;border-top:2px solid var(--primary);padding-top:16px;min-width:0}.flow-number{display:block;font-size:12px;color:var(--primary);font-variant-numeric:tabular-nums;margin-bottom:13px}.science-flow strong{display:block;font-size:17px;line-height:1.4;font-weight:600}.science-flow p{font-size:14px;line-height:1.6;color:var(--muted);margin:9px 0 0}.flow-direction{position:absolute;right:-25px;top:35px;color:var(--dim)}.slide-relation{font-size:clamp(19px,2.6vw,28px);font-weight:500;letter-spacing:-.03em;line-height:1.5;margin:25px 0 5px;color:var(--primary)}.layout-references .slide-heading{margin-bottom:20px}.source-files{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px;margin:24px 0 28px}.source-files a{display:grid;grid-template-columns:1fr auto;align-items:center;gap:7px 10px;border-block:1px solid var(--line);padding:18px 0;color:var(--text)}.source-files a>span:first-child{font-size:20px;letter-spacing:-.02em}.source-files small{grid-row:2;color:var(--dim);font-size:13px}.source-files a>span:last-child{grid-column:2;grid-row:1/3;color:var(--primary);font-size:24px}.deck-references{font-size:14px;line-height:1.55;padding-left:20px;color:var(--dim);margin:0;display:grid;gap:10px}.deck-references a{color:var(--muted)}.deck-references a:hover{color:var(--primary)}
  .deck-bottom{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:12px 20px;border-top:1px solid var(--line);background:var(--surface-2)}.keyboard-hint{margin:0;font-size:12px;color:var(--dim)}.deck-pagination{display:flex;gap:16px;align-items:center}.deck-pagination button{font-size:13px;min-width:82px}.slide-count{font-size:12px;color:var(--dim);font-variant-numeric:tabular-nums;min-width:38px;text-align:center}.report-return{display:flex;justify-content:space-between;gap:20px;font-size:13px;margin:20px 0;color:var(--dim)}.report-return a{color:var(--muted)}
  .paper-deck:fullscreen,.paper-deck[data-expanded="true"]{display:flex;flex-direction:column;width:100%;height:100dvh;border:0;border-radius:0;background:var(--bg)}.paper-deck[data-expanded="true"]{position:fixed;inset:0;z-index:90}.paper-deck:fullscreen .deck-stage,.paper-deck[data-expanded="true"] .deck-stage{flex:1;min-height:0;overflow:auto}.paper-deck:fullscreen[data-mode="slides"] .paper-slide,.paper-deck[data-expanded="true"][data-mode="slides"] .paper-slide{height:100%;min-height:0;max-width:1500px;margin:auto}.paper-deck:fullscreen .slide-heading h2,.paper-deck[data-expanded="true"] .slide-heading h2{font-size:clamp(28px,3vw,42px)}.paper-deck:fullscreen .slide-figures img{max-height:min(48vh,500px)}
  @media(max-width:1000px){.paper-heading{align-items:flex-start;flex-direction:column;gap:17px}.paper-slide{padding:30px 30px 16px}.paper-deck[data-mode="slides"] .paper-slide{height:720px}.layout-cover .slide-composition{gap:30px}.slide-heading{margin-bottom:24px}.slide-composition{gap:24px}.slide-copy>p.slide-lead{font-size:19px}.slide-copy>p{font-size:16px}.slide-points dd{font-size:15px}.slide-figures figcaption{font-size:12px}.layout-text .slide-points dd{font-size:16px}}
  @media(max-width:700px){.presentation-page{padding-top:20px}.paper-heading h1{font-size:25px}.paper-heading{margin:20px 0}.paper-downloads{width:100%}.paper-downloads a{font-size:13px}.paper-downloads small{display:none}.paper-deck{border-radius:9px}.deck-toolbar{padding:10px 12px;gap:8px;flex-wrap:wrap}.slide-picker{max-width:100%;flex-basis:100%}.slide-picker select{padding:0;min-height:32px;font-size:13px}.deck-actions{margin-left:auto}.deck-actions button{font-size:12px;min-height:33px}.paper-slide,.paper-deck[data-mode="slides"] .paper-slide{height:auto;min-height:580px;padding:27px 22px 16px;overflow:visible}.slide-heading h2{font-size:27px}.layout-cover .slide-heading h2{font-size:33px}.layout-cover .slide-composition,.layout-wide .slide-composition,.layout-split .slide-composition{grid-template-columns:minmax(0,1fr);gap:28px}.layout-cover .slide-copy>.slide-lead{font-size:20px}.cover-publication{font-size:12px;margin-top:20px}.slide-figures{max-width:540px;margin:0 auto;width:100%}.layout-cover .slide-figures{max-width:250px}.slide-figures img{max-height:400px}.slide-metrics{gap:15px;margin-top:20px}.slide-metrics dt{font-size:28px}.slide-metrics dd{font-size:12px}.layout-text .slide-points{grid-template-columns:minmax(0,1fr);gap:20px}.slide-points dd{font-size:16px}.slide-points dt{font-size:16px}.science-flow{grid-template-columns:1fr;gap:20px;margin:26px 0 20px}.science-flow li{padding:0 0 0 46px;border:0;min-height:55px}.science-flow .flow-number{position:absolute;left:0;top:0;font-size:15px}.science-flow p{margin:5px 0 0;font-size:15px}.flow-direction{left:4px;right:auto;top:auto;bottom:-23px;transform:rotate(90deg)}.slide-takeaway{font-size:16px;margin-top:24px;padding-left:13px}.slide-footnote{margin-top:24px;font-size:10px}.deck-bottom{padding:12px;justify-content:center}.keyboard-hint{display:none}.deck-pagination{width:100%;justify-content:space-between;gap:12px}.deck-pagination button{min-width:84px;font-size:13px}.slide-count{font-size:13px}.source-files{grid-template-columns:1fr;gap:14px}.source-files a{padding:15px 0}.deck-references{font-size:13px}.paper-deck:fullscreen[data-mode="slides"] .paper-slide,.paper-deck[data-expanded="true"][data-mode="slides"] .paper-slide{height:auto;min-height:100%;overflow:visible}.paper-deck:fullscreen .slide-heading h2,.paper-deck[data-expanded="true"] .slide-heading h2{font-size:28px}.paper-deck:fullscreen .slide-figures img{max-height:400px}}
  @media print{.paper-heading{margin:15px 0}.paper-downloads,.deck-toolbar,.deck-bottom,.report-return{display:none!important}.paper-deck{border:0;overflow:visible}.paper-slide,.paper-deck[data-mode="slides"] .paper-slide{display:flex!important;height:auto;min-height:0;break-after:page;overflow:visible;padding:20px 0}.paper-slide:last-child{break-after:auto}.slide-figures img{max-height:350px}.slide-footnote{margin-top:22px}}
  @media screen and (min-width:701px){.layout-wide .slide-composition{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)}.paper-deck:fullscreen .slide-figures img{max-height:min(41vh,410px)}}
  @media screen and (max-width:700px){.slide-figures.figure-pair{grid-template-columns:minmax(0,1fr);gap:26px}}
  .layout-wide .slide-metrics dt{font-size:26px;white-space:nowrap}
</style>

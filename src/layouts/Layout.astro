---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = "Ray_Lee’s Research Journal — daily research records, English learning, and photoacoustic imaging notes." } = Astro.props;
const path = Astro.url.pathname;
const navigation = [ { href: '/', label: 'Daily Journal' }, { href: '/english', label: 'English Learning' }, { href: '/photoacoustic', label: 'Photoacoustic Imaging' } ];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f7f6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('ray-journal-theme') === 'dark' ? 'dark' : 'light'; } catch {}</script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="app">
      <header class="journal-header">
        <a class="brand" href="/" aria-label="Ray_Lee’s Research Journal home">
          <span class="brand-mark" aria-hidden="true">R</span>
          <span class="brand-copy"><span class="brand-name">Ray_Lee’s Research Journal</span><span class="brand-meta">Research, learning & everyday notes</span></span>
        </a>
        <div class="toolbar">
          <div class="clock"><div class="clock-time" id="clock">--:--</div><div class="clock-date" id="clockDate">Beijing · UTC+08:00</div></div>
          <button class="icon-btn" id="themeBtn" title="Toggle light or dark theme" aria-label="Toggle theme">☼</button>
          <button class="subtle-btn" id="fullscreenBtn" title="Enter fullscreen mode">⛶ <span class="button-label">Fullscreen</span></button>
          <button class="subtle-btn" id="editorAccessBtn" title="Owner editing">Enable editing</button>
        </div>
      </header>
      <nav class="site-nav" aria-label="Main navigation">
        {navigation.map((item, index) => <a href={item.href} class:list={{ active: item.href === '/' ? path === '/' : path.startsWith(item.href) }} aria-current={(item.href === '/' ? path === '/' : path.startsWith(item.href)) ? 'page' : undefined}><span class="nav-index">0{index + 1}</span>{item.label}</a>)}
        <span class="nav-status" id="accessStatus">Public view</span>
      </nav>
      <main id="content"><slot /></main>
      <footer class="site-footer"><span>Ray_Lee’s Research Journal · A record of things learned</span><span>Beijing time · UTC+08:00</span></footer>
    </div>
    <dialog id="editorAccessDialog" aria-labelledby="accessTitle">
      <form id="editorAccessForm">
        <div class="dialog-head"><div><h2 id="accessTitle">Enable editing</h2><p>Public reading stays open. Your management password unlocks changes.</p></div><button type="button" class="icon-btn" id="closeAccess" aria-label="Close">×</button></div>
        <div class="dialog-body"><label class="access-label" for="managementPassword">Management password</label><input class="editor-input" id="managementPassword" type="password" required maxlength="200" autocomplete="current-password" /><p id="accessError" class="access-error" role="alert"></p></div>
        <div class="dialog-foot"><span class="save-hint">Editor access lasts 7 days on this device.</span><button class="filled-btn" type="submit" id="unlockBtn">Unlock editing</button></div>
      </form>
    </dialog>
    <script src="../scripts/shell.ts"></script>
  </body>
</html>

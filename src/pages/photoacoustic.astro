---
import Layout from "../layouts/Layout.astro";
import LibraryExplorer from "../components/LibraryExplorer.astro";
import { publishedPapers } from "../lib/library";
export const prerender = true;
const papers = await publishedPapers();
---
<Layout title="Paper Library | Ray_Lee’s Research Journal" description="Search photoacoustic imaging papers and download original articles and reading notes.">
  <div class="library-page">
    <header class="page-heading"><div><p class="eyebrow">Photoacoustic Imaging</p><h1>Paper Library</h1></div></header>
    <LibraryExplorer mode="papers" papers={papers} />
  </div>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import LibraryExplorer from "../components/LibraryExplorer.astro";
import { publishedEnglish } from "../lib/library";
export const prerender = true;
const entries = await publishedEnglish();
---
<Layout title="English Learning | Ray_Lee’s Research Journal" description="Speaking, vocabulary, and English learning notes.">
  <div class="library-page">
    <header class="page-heading"><div><p class="eyebrow">Language notebook</p><h1>English Learning</h1><p class="lede">A speaking corpus and vocabulary collected from reading, listening, and academic writing.</p></div></header>
    <LibraryExplorer mode="english" english={entries} />
  </div>
</Layout>

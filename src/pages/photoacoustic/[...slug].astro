---
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import LibraryExplorer from "../../components/LibraryExplorer.astro";
import PaperReport from "../../components/PaperReport.astro";
import { publishedPapers, paperCategory, researchCategories, researchGroups } from "../../lib/library";

export const prerender = true;

export async function getStaticPaths() {
  const papers = await publishedPapers();
  return [
    ...researchGroups.map((group) => ({ params: { slug: group.slug }, props: { activePath: group.slug, title: group.title, description: group.description, papers } })),
    ...researchCategories.map((category) => ({ params: { slug: category.path }, props: { activePath: category.path, title: category.title, description: category.description, papers } })),
    ...papers.map((paper) => ({ params: { slug: `${paperCategory(paper.data.category).path}/${paper.data.slug}` }, props: { paper } })),
  ];
}

interface Props {
  paper?: CollectionEntry<"papers">;
  activePath?: string;
  title?: string;
  description?: string;
  papers?: CollectionEntry<"papers">[];
}

const { paper, activePath = "", title = "Photoacoustic Imaging", description, papers = [] } = Astro.props;
const category = researchCategories.find((item) => item.path === activePath);
---

<Layout title={`${paper?.data.title ?? title} | Ray_Lee’s Research Journal`} description={paper?.data.summary ?? description}>
  {paper ? <PaperReport paper={paper} /> : (
    <div class="category-page">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/photoacoustic/">Photoacoustic Imaging</a><span aria-hidden="true">/</span>{category && <><a href={`/photoacoustic/${category.groupSlug}/`}>{category.groupTitle}</a><span aria-hidden="true">/</span></>}<span aria-current="page">{title}</span></nav>
      <header class="page-heading"><h1>{title}</h1></header>
      <LibraryExplorer mode="papers" papers={papers} activePath={activePath} heading="Papers" />
    </div>
  )}
</Layout>

<style>
  a{color:inherit;text-decoration:none}
  .category-page{padding:24px 0 0;overflow-wrap:anywhere}
  .breadcrumbs{display:flex;gap:9px;align-items:center;flex-wrap:wrap;font-size:13px;line-height:1.7;color:var(--dim)}
  .breadcrumbs a:hover{color:var(--primary)}
  .page-heading{padding:20px 0 26px}
  @media(max-width:760px){.category-page{padding-top:20px}.breadcrumbs{font-size:12px;gap:7px}.page-heading{padding:18px 0 22px}}
</style>

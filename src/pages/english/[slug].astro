---
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { noteBlocks, publishedEnglish } from "../../lib/library";

export const prerender = true;

export async function getStaticPaths() {
  return (await publishedEnglish()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

interface Props { entry: CollectionEntry<"english">; }
const { entry } = Astro.props;
const data = entry.data;
const blocks = noteBlocks(entry.body);
---

<Layout title={`${data.title} | English Learning | Ray_Lee’s Research Journal`} description={data.meaning}>
  <article class="language-record">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/english/">English Learning</a><span aria-hidden="true">/</span><span>{data.type === "speaking" ? "Speaking" : "Vocabulary"}</span><span aria-hidden="true">/</span><span aria-current="page">{data.category}</span></nav>
    <header class="record-header"><p class="eyebrow">{data.type === "speaking" ? "SPEAKING CORPUS" : "VOCABULARY"} / {data.category}</p><h1 lang="en">{data.title}</h1>{data.pronunciation && <p class="pronunciation">{data.pronunciation}</p>}<p class="meaning">{data.meaning}</p>{data.tags.length > 0 && <div class="record-tags">{data.tags.map((tag) => <span>{tag}</span>)}</div>}{data.updated && <p class="updated">Updated {data.updated}</p>}</header>
    {data.context && <section class="record-section"><h2>Usage</h2><p class="context">{data.context}</p></section>}
    {data.examples.length > 0 && <section class="record-section"><h2>Examples</h2><div class="examples">{data.examples.map((example, index) => <div class="example"><span class="example-number">{String(index + 1).padStart(2, "0")}</span><div><p lang="en">{example.english}</p>{example.chinese && <p class="translation">{example.chinese}</p>}</div></div>)}</div></section>}
    {blocks.length > 0 && <section class="record-section reading-notes"><h2>Notes</h2>{blocks.map((block) => block.type === "heading" ? <h3>{block.text}</h3> : block.type === "paragraph" ? <p>{block.text}</p> : block.type === "quote" ? <blockquote>{block.text}</blockquote> : block.ordered ? <ol>{block.items.map((item) => <li>{item}</li>)}</ol> : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>)}</section>}
    {data.sources.length > 0 && <section class="record-section"><h2>Sources</h2><ul class="source-list">{data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <span aria-hidden="true">↗</span></a></li>)}</ul></section>}
    <footer class="record-footer"><a href="/english/">Back to English Learning <span aria-hidden="true">↗</span></a></footer>
  </article>
</Layout>

<style>
  a{color:inherit;text-decoration:none}.language-record{max-width:860px;margin:0 auto;padding:28px 0 64px;overflow-wrap:anywhere}
  .breadcrumbs{display:flex;gap:9px;flex-wrap:wrap;align-items:center;font-size:14px;line-height:1.7;color:var(--dim);margin-bottom:28px}.breadcrumbs a:hover{color:var(--primary)}
  .record-header{display:block;padding:0 0 28px;border:0;align-items:normal;justify-content:normal}.record-header .eyebrow{font-size:14px;line-height:1.7;font-weight:600;letter-spacing:.06em;color:var(--teal);margin:0 0 10px}.record-header h1{font-size:clamp(30px,4vw,38px);font-weight:650;line-height:1.35;letter-spacing:-.035em;margin:0 0 14px}.pronunciation{font-size:17px;color:var(--dim);line-height:1.7;margin:0 0 12px}.meaning{font-size:18px;line-height:1.9;color:var(--muted);white-space:pre-line;margin:0}
  .record-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}.record-tags span{font-size:14px;padding:3px 9px;background:var(--surface-2);border-radius:4px;color:var(--muted)}.updated{font-size:14px;line-height:1.7;color:var(--dim);margin:16px 0 0}
  .record-section{border-top:1px solid var(--line);padding:28px 0}.section-kicker{font-size:14px;font-weight:600;line-height:1.6;letter-spacing:.06em;color:var(--teal);margin:0 0 6px}.record-section h2{font-size:24px;font-weight:650;line-height:1.5;letter-spacing:-.025em;margin:0 0 18px}.context{font-size:18px;line-height:1.9;color:var(--muted);white-space:pre-line;margin:0}
  .example{display:grid;grid-template-columns:28px minmax(0,1fr);gap:15px;align-items:baseline;padding:0 0 23px}.example+.example{border-top:1px solid var(--line);padding-top:23px}.example:last-child{padding-bottom:0}.example-number{font-size:14px;font-variant-numeric:tabular-nums;color:var(--dim)}.example>div{min-width:0}.example>div>p:first-child{font-size:21px;line-height:1.7;margin:0 0 8px;letter-spacing:-.01em}.translation{font-size:17px;line-height:1.85;color:var(--muted);margin:0}
  .reading-notes p,.reading-notes ul,.reading-notes ol,.reading-notes blockquote{font-size:18px;line-height:1.9;color:var(--muted);white-space:pre-line;margin:0 0 18px}.reading-notes h3{font-size:20px;font-weight:600;line-height:1.6;margin:25px 0 12px}.reading-notes ul,.reading-notes ol{padding-left:24px}.reading-notes blockquote{padding-left:18px;border-left:3px solid var(--teal)}.source-list{padding-left:21px;line-height:1.9;font-size:17px;color:var(--muted);margin:0}.source-list li+li{margin-top:8px}.source-list a:hover{color:var(--primary);text-decoration:underline}
  .record-footer{border-top:1px solid var(--line);padding-top:24px;display:flex;flex-wrap:wrap;gap:14px 24px;justify-content:space-between;align-items:baseline}.record-footer>span{font-size:14px;line-height:1.7;color:var(--dim)}.record-footer>a{font-size:15px;line-height:1.7;color:var(--teal)}
  @media(max-width:650px){.language-record{padding:24px 0 48px}.breadcrumbs{margin-bottom:24px;gap:7px}.record-header h1{font-size:30px}.record-section h2{font-size:23px}.example{grid-template-columns:23px minmax(0,1fr);gap:10px}.example>div>p:first-child{font-size:20px}.meaning,.context,.reading-notes p,.reading-notes ul,.reading-notes ol,.reading-notes blockquote{font-size:17px}}
  @media(max-width:380px){.language-record{padding-left:0;padding-right:0}}
</style>
